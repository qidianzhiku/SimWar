{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/schemas/regional-transfer.v1.json",
  "title": "Governed Regional Transfer and Scenario Evolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_ref",
    "consumer_scope",
    "scope",
    "baseline",
    "target",
    "formal_references",
    "provenance",
    "qualification",
    "diff",
    "impact",
    "activation",
    "authority",
    "rollback",
    "lifecycle",
    "known_limits"
  ],
  "properties": {
    "schema_version": { "const": "regional-transfer.v1" },
    "candidate_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "content_digest", "tenant_id", "version"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_id", "round_no", "run_id", "tenant_id"],
      "properties": {
        "course_id": { "type": "string", "minLength": 1 },
        "round_no": { "type": "integer", "minimum": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 }
      }
    },
    "consumer_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_team_count", "run_id", "status", "team_ids"],
      "properties": {
        "minimum_team_count": { "const": 2 },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "const": "SHARED_GOVERNED_SCENARIO" },
        "team_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "baseline": { "$ref": "#/$defs/regionPackage" },
    "target": { "$ref": "#/$defs/regionPackage" },
    "formal_references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_blueprint_reference",
        "parameter_set_reference",
        "scenario_package_reference"
      ],
      "properties": {
        "course_blueprint_reference": { "$ref": "#/$defs/courseBlueprintReference" },
        "parameter_set_reference": { "$ref": "#/$defs/parameterSetReference" },
        "scenario_package_reference": { "$ref": "#/$defs/scenarioPackageReference" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_source_readback", "support_packs"],
      "properties": {
        "current_source_readback": { "const": "EXACT_SOURCE_READBACK_REQUIRED" },
        "support_packs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "m4_pack_digest",
            "m4_source_revision",
            "m5_pack_digest",
            "m5_source_revision",
            "m6_pack_digest",
            "m6_source_revision"
          ],
          "properties": {
            "m4_pack_digest": { "$ref": "#/$defs/digest" },
            "m4_source_revision": { "$ref": "#/$defs/sha" },
            "m5_pack_digest": { "$ref": "#/$defs/digest" },
            "m5_source_revision": { "$ref": "#/$defs/sha" },
            "m6_pack_digest": { "$ref": "#/$defs/digest" },
            "m6_source_revision": { "$ref": "#/$defs/sha" }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_eligible", "rights_status", "status", "source_status"],
      "properties": {
        "calibration_eligible": { "const": false },
        "rights_status": { "const": "PUBLIC_SAFE" },
        "status": { "const": "READY_WITH_LIMITS" },
        "source_status": { "const": "REFERENCE_ONLY_WITH_SYNTHETIC_FALLBACK" }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes", "status"],
      "properties": {
        "status": { "const": "DIFF_RECORDED" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "from", "to"],
            "properties": {
              "field": { "enum": ["region", "package", "qualification"] },
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_consumers", "requalification_required", "rollback_candidate"],
      "properties": {
        "affected_consumers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requalification_required": { "const": true },
        "rollback_candidate": { "const": true }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published", "status"],
      "properties": {
        "published": { "type": "boolean" },
        "status": { "enum": ["ACTIVATED", "NOT_ACTIVATED"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_writer_mutations",
        "official_truth_write",
        "provider",
        "runtime_authority",
        "settlement_write"
      ],
      "properties": {
        "formal_writer_mutations": { "const": 0 },
        "official_truth_write": { "const": false },
        "provider": { "const": "OFF" },
        "runtime_authority": { "const": "JSON_INTERNAL_ONLY" },
        "settlement_write": { "const": false }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_version",
        "dry_run",
        "executed",
        "resolution",
        "rollback_version",
        "version_guard"
      ],
      "properties": {
        "candidate_version": { "type": "string" },
        "dry_run": { "const": true },
        "executed": { "const": false },
        "resolution": { "const": "SAFE_DRY_RUN_CANDIDATE" },
        "rollback_version": { "type": "string" },
        "version_guard": { "const": "EXACT_VERSION_REQUIRED" }
      }
    },
    "lifecycle": { "enum": ["PREVIEWED", "VALIDATED", "FROZEN", "ACTIVATED"] },
    "known_limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "operation_id": {
      "enum": [
        "REGIONAL_TRANSFER_TEACHER_LIST_V1",
        "REGIONAL_TRANSFER_PREVIEW_V1",
        "REGIONAL_TRANSFER_VALIDATE_V1"
      ]
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "courseBlueprintReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "course_blueprint_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_blueprint_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      }
    },
    "parameterSetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "parameter_set_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "parameter_set_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      }
    },
    "scenarioPackageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "scenario_package_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "scenario_package_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      }
    },
    "regionPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_reference", "region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "package_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "package_id", "version"],
          "properties": {
            "digest": { "$ref": "#/$defs/digest" },
            "package_id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
          }
        }
      }
    }
  }
}
