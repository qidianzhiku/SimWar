{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/m2p5-decision-learning-crossround.v1.json",
  "title": "M2-P5 Project-Aware Decision Learning Cross-Round Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_authority",
    "visibility",
    "exact_scope",
    "official_consequence",
    "learning",
    "project_context",
    "cross_round",
    "learning_loop",
    "known_limits"
  ],
  "properties": {
    "schema_version": { "const": "m2p5-decision-learning-crossround.v1" },
    "runtime_authority": { "const": "JSON_INTERNAL_ONLY" },
    "visibility": { "enum": ["student_safe", "teacher_safe"] },
    "exact_scope": { "$ref": "#/$defs/context" },
    "official_consequence": {
      "type": "object",
      "required": ["record"],
      "properties": {
        "state_true": false,
        "replay_hash": false,
        "record": {
          "type": "object",
          "required": ["publication"],
          "properties": {
            "publication": {
              "type": "object",
              "required": ["status"],
              "properties": { "status": { "const": "PUBLISHED" } }
            },
            "operating_world_consequence_trace": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "trace_id",
                "scope",
                "operating_world_binding_digest",
                "canonical_decision_ref",
                "settlement_result_ref",
                "replay_relevant_digest",
                "publication",
                "allowed_effects",
                "constraints",
                "known_limits",
                "source_classification",
                "official_delta",
                "writes_official_state",
                "causal_authority",
                "ai_generated"
              ],
              "properties": {
                "schema_version": { "const": "operating-world-consequence-trace.v1" },
                "trace_id": { "$ref": "#/$defs/identity" },
                "scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tenant_id", "course_id", "run_id", "round_no", "team_id"],
                  "properties": {
                    "tenant_id": { "$ref": "#/$defs/identity" },
                    "course_id": { "$ref": "#/$defs/identity" },
                    "run_id": { "$ref": "#/$defs/identity" },
                    "round_no": { "type": "integer", "minimum": 1 },
                    "team_id": { "$ref": "#/$defs/identity" }
                  }
                },
                "operating_world_binding_digest": { "$ref": "#/$defs/digest" },
                "canonical_decision_ref": { "$ref": "#/$defs/identity" },
                "w4_action_ref": { "$ref": "#/$defs/identity" },
                "w4_replay_manifest_ref": { "$ref": "#/$defs/identity" },
                "settlement_result_ref": { "$ref": "#/$defs/identity" },
                "replay_relevant_digest": { "$ref": "#/$defs/digest" },
                "publication": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status"],
                  "properties": {
                    "status": { "enum": ["SETTLED_UNPUBLISHED", "PUBLISHED"] },
                    "published_at": { "type": "string" }
                  }
                },
                "allowed_effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "family",
                      "key",
                      "classification",
                      "input_bucket",
                      "consumer",
                      "outcome_field",
                      "effect_direction"
                    ],
                    "properties": {
                      "family": { "const": "SH-17" },
                      "key": { "const": "capital_cost" },
                      "classification": {
                        "enum": [
                          "OFFICIAL_CONSUMER_ELIGIBLE",
                          "SHADOW_ONLY",
                          "INFORMATION_ONLY",
                          "BLOCKED"
                        ]
                      },
                      "input_bucket": {
                        "enum": ["0.00-0.25", "0.25-0.50", "0.50-0.75", "0.75-1.00", "UNKNOWN"]
                      },
                      "consumer": { "const": "W4_CAPITAL_ACTION_OR_NEW_PROJECT_ADMISSION" },
                      "outcome_field": { "const": "rate_or_cost_bps" },
                      "effect_direction": {
                        "enum": ["constrains", "increases", "decreases", "unchanged"]
                      }
                    }
                  }
                },
                "constraints": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/safeText" }
                },
                "known_limits": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/safeText" }
                },
                "source_classification": {
                  "enum": [
                    "OFFICIAL_CONSUMER_ELIGIBLE",
                    "SHADOW_ONLY",
                    "INFORMATION_ONLY",
                    "BLOCKED"
                  ]
                },
                "official_delta": { "enum": ["NONE", "WHITELISTED_ONLY"] },
                "writes_official_state": { "const": false },
                "causal_authority": { "const": "DETERMINISTIC_SYSTEM_FACTS" },
                "ai_generated": { "const": false }
              }
            }
          }
        }
      }
    },
    "learning": { "$ref": "#/$defs/learning" },
    "learning_report": { "type": "object" },
    "project_context": { "$ref": "#/$defs/projectContext" },
    "cross_round": { "$ref": "#/$defs/crossRound" },
    "learning_loop": { "$ref": "#/$defs/learningLoop" },
    "known_limits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/safeText" } }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$",
      "not": {
        "pattern": "(?:^|[._:-])(?:any|current|default|fallback|latest|next|unresolved)(?:$|[._:-])"
      }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "w3ExactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "discriminator",
        "resource_id",
        "resource_type",
        "tenant_id",
        "version"
      ],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "discriminator": { "const": "exact_ref" },
        "resource_id": { "$ref": "#/$defs/identity" },
        "resource_type": {
          "enum": [
            "canonical_decision",
            "course",
            "evidence_artifact",
            "learning_goal_version",
            "round",
            "run",
            "settlement_result",
            "student_learning_report",
            "teacher_confirmation_version",
            "transformation_rule"
          ]
        },
        "tenant_id": { "$ref": "#/$defs/identity" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "canonicalDecisionRef": {
      "allOf": [
        { "$ref": "#/$defs/w3ExactRef" },
        {
          "type": "object",
          "properties": { "resource_type": { "const": "canonical_decision" } }
        }
      ]
    },
    "roundExactRef": {
      "allOf": [
        { "$ref": "#/$defs/w3ExactRef" },
        { "type": "object", "properties": { "resource_type": { "const": "round" } } }
      ]
    },
    "settlementExactRef": {
      "allOf": [
        { "$ref": "#/$defs/w3ExactRef" },
        {
          "type": "object",
          "properties": { "resource_type": { "const": "settlement_result" } }
        }
      ]
    },
    "teacherConfirmationExactRef": {
      "allOf": [
        { "$ref": "#/$defs/w3ExactRef" },
        {
          "type": "object",
          "properties": {
            "resource_type": { "const": "teacher_confirmation_version" }
          }
        }
      ]
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "course_id",
        "role_key",
        "round_id",
        "round_no",
        "run_id",
        "team_id",
        "tenant_id"
      ],
      "properties": {
        "activity_id": { "$ref": "#/$defs/identity" },
        "course_id": { "$ref": "#/$defs/identity" },
        "role_key": { "$ref": "#/$defs/identity" },
        "round_id": { "$ref": "#/$defs/identity" },
        "round_no": { "type": "integer", "minimum": 1 },
        "run_id": { "$ref": "#/$defs/identity" },
        "team_id": { "$ref": "#/$defs/identity" },
        "tenant_id": { "$ref": "#/$defs/identity" }
      }
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "project_profile_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "project_profile_id": { "$ref": "#/$defs/identity" },
        "tenant_id": { "$ref": "#/$defs/identity" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "course_id",
        "run_id",
        "team_id",
        "round_id",
        "enterprise_state_id",
        "version",
        "state_digest"
      ],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/identity" },
        "course_id": { "$ref": "#/$defs/identity" },
        "run_id": { "$ref": "#/$defs/identity" },
        "team_id": { "$ref": "#/$defs/identity" },
        "round_id": { "$ref": "#/$defs/identity" },
        "enterprise_state_id": { "$ref": "#/$defs/identity" },
        "version": { "type": "integer", "minimum": 1 },
        "state_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "reflection_status",
        "teacher_confirmation_status",
        "evidence_selection_status",
        "student_learning_report_status",
        "next_round_hypothesis_status"
      ],
      "properties": {
        "gate": { "enum": ["BLOCKED", "READY"] },
        "reflection_status": { "enum": ["MISSING", "SUBMITTED"] },
        "teacher_confirmation_status": { "enum": ["MISSING", "DRAFT", "CONFIRMED"] },
        "evidence_selection_status": { "enum": ["NOT_SELECTED", "SELECTED"] },
        "student_learning_report_status": { "enum": ["MISSING", "CONFIRMED"] },
        "teacher_confirmation_ref": { "type": "object" },
        "student_learning_report_ref": { "type": "object" },
        "next_round_hypothesis_status": { "enum": ["BLOCKED", "READY"] }
      }
    },
    "projectContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["RESOLVED", "BLOCKED"] },
        "project_profile_reference": { "$ref": "#/$defs/exactRef" },
        "title": { "$ref": "#/$defs/safeText" },
        "student_brief": { "type": "object" },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/safeText" } }
      }
    },
    "crossRound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entry_status", "blocker_codes"],
      "properties": {
        "status": { "enum": ["BLOCKED", "READY_TO_CONTINUE", "ENTRY_READY"] },
        "entry_status": { "enum": ["NOT_CREATED", "DRAFT", "OPEN", "BLOCKED"] },
        "blocker_codes": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "predecessor_closing_state_ref": { "$ref": "#/$defs/stateRef" },
        "next_round": {
          "type": "object",
          "additionalProperties": false,
          "required": ["round_id", "round_no", "status"],
          "properties": {
            "round_id": { "$ref": "#/$defs/identity" },
            "round_no": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["draft", "open", "locked", "settled", "published"] },
            "opening_state_ref": { "$ref": "#/$defs/stateRef" },
            "source_closing_state_ref": { "$ref": "#/$defs/stateRef" }
          }
        }
      }
    },
    "learningLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "exact_context",
        "canonical_decision_ref",
        "published_consequence_ref",
        "teacher_confirmation_status",
        "teacher_debrief_availability",
        "student_learning_report_status",
        "reflection_status",
        "what_if_availability",
        "transfer_status",
        "next_opening_state_readiness",
        "blockers",
        "allowed_actions",
        "recovery_state",
        "source_receipts",
        "provenance_refs"
      ],
      "properties": {
        "schema_version": { "const": "m2p6-teacher-debrief-learning-transfer.v1" },
        "status": { "enum": ["READY", "BLOCKED", "CONFLICT", "UNKNOWN"] },
        "exact_context": { "$ref": "#/$defs/context" },
        "canonical_decision_ref": { "$ref": "#/$defs/canonicalDecisionRef" },
        "published_consequence_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_id", "round_ref", "settlement_ref"],
          "properties": {
            "record_id": { "$ref": "#/$defs/identity" },
            "round_ref": { "$ref": "#/$defs/roundExactRef" },
            "settlement_ref": { "$ref": "#/$defs/settlementExactRef" }
          }
        },
        "teacher_confirmation_status": { "enum": ["MISSING", "DRAFT", "CONFIRMED"] },
        "teacher_confirmation_ref": { "$ref": "#/$defs/teacherConfirmationExactRef" },
        "teacher_debrief_availability": { "enum": ["AVAILABLE", "BLOCKED", "UNKNOWN"] },
        "student_learning_report_status": { "enum": ["MISSING", "CONFIRMED"] },
        "reflection_status": { "enum": ["MISSING", "SUBMITTED"] },
        "what_if_availability": { "enum": ["AVAILABLE", "NOT_GENERATED", "BLOCKED"] },
        "transfer_status": { "enum": ["READY", "BLOCKED"] },
        "next_opening_state_readiness": {
          "enum": ["ENTRY_READY", "READY_TO_CONTINUE", "BLOCKED"]
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "REVIEW_EVIDENCE",
              "USE_EXISTING_D3_CONFIRMATION",
              "PREPARE_DEBRIEF",
              "CREATE_NON_OFFICIAL_WHAT_IF",
              "REVIEW_NON_OFFICIAL_WHAT_IF",
              "SUBMIT_AI_OFF_REFLECTION",
              "REVIEW_TRANSFER",
              "ENTER_NEXT_ROUND"
            ]
          }
        },
        "recovery_state": { "const": "EXACT_CONTEXT_RESTORED" },
        "source_receipts": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/w3ExactRef" }
        },
        "provenance_refs": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/w3ExactRef" }
        },
        "state_true": false,
        "replay_hash": false,
        "replay_input_manifest": false,
        "decision_batch_hash": false,
        "json_runtime_source_digest": false,
        "canonical_evidence_digest": false,
        "authority_diagnostics": false
      }
    }
  }
}
