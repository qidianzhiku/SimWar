{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/w4-counterfactual.v1.json",
  "title": "W4 Non-Official Counterfactual Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "counterfactual_id",
    "source_outcome_id",
    "source_state_ref",
    "decision_ids",
    "decision_payload_bindings",
    "scenario_package_id",
    "parameter_set_id",
    "engine_id",
    "plugin_ids",
    "seed",
    "horizon_rounds",
    "rounds",
    "official_decision_writes",
    "official_settlement_writes",
    "official_state_writes",
    "apply_to_next_round",
    "replay_writes_formal_results",
    "known_limits"
  ],
  "properties": {
    "surface": { "enum": ["student", "teacher"] },
    "counterfactual_id": { "type": "string", "minLength": 1 },
    "source_outcome_id": { "type": "string", "minLength": 1 },
    "source_state_ref": { "$ref": "#/$defs/stateRef" },
    "decision_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision_payload_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decisionPayloadBinding" }
    },
    "scenario_package_id": { "type": "string", "minLength": 1 },
    "parameter_set_id": { "type": "string", "minLength": 1 },
    "engine_id": { "type": "string", "minLength": 1 },
    "plugin_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "seed": { "type": "integer", "minimum": 0 },
    "horizon_rounds": { "type": "integer", "minimum": 1, "maximum": 8 },
    "capital_actions": { "type": "array", "items": { "$ref": "#/$defs/capitalAction" } },
    "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/round" } },
    "official_decision_writes": { "const": false },
    "official_settlement_writes": { "const": false },
    "official_state_writes": { "const": false },
    "apply_to_next_round": { "const": false },
    "replay_writes_formal_results": { "const": false },
    "known_limits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "surface": { "const": "teacher" } } },
      "then": {
        "required": ["capital_actions"],
        "properties": { "capital_actions": { "type": "array" } }
      }
    },
    {
      "if": { "properties": { "surface": { "const": "student" } } },
      "then": { "not": { "required": ["capital_actions"] } }
    }
  ],
  "$defs": {
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "course_id",
        "run_id",
        "team_id",
        "round_id",
        "enterprise_state_id",
        "version",
        "state_digest"
      ],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "enterprise_state_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "state_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parent_state_ref": {
          "anyOf": [{ "$ref": "#/$defs/stateRef" }, { "type": "null" }]
        }
      }
    },
    "decisionPayloadBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_payload_digest"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "decision_payload_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "state": { "type": "object", "additionalProperties": true },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_no",
        "opening_state_ref",
        "closing_state_ref",
        "opening_state",
        "closing_state",
        "opening_digest",
        "closing_digest",
        "changed_paths"
      ],
      "properties": {
        "round_no": { "type": "integer", "minimum": 1 },
        "opening_state_ref": { "$ref": "#/$defs/stateRef" },
        "closing_state_ref": { "$ref": "#/$defs/stateRef" },
        "opening_state": { "$ref": "#/$defs/state" },
        "closing_state": { "$ref": "#/$defs/state" },
        "opening_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "closing_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "changed_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "capitalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capital_action_id",
        "decision_id",
        "decision_payload_digest",
        "tenant_id",
        "course_id",
        "run_id",
        "team_id",
        "kind",
        "status",
        "principal",
        "term_rounds",
        "rate_or_cost_bps",
        "cost_source",
        "covenant_min_cash",
        "fees",
        "obligation",
        "project_entry_id",
        "initiative_id",
        "policy_seam_id",
        "created_round_no",
        "effective_round_no",
        "maturity_round_no"
      ],
      "properties": {
        "capital_action_id": { "type": "string", "minLength": 1 },
        "decision_id": { "type": "string", "minLength": 1 },
        "decision_payload_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "debt",
            "project_finance",
            "working_capital",
            "asset_backed_securitization",
            "initial_public_offering"
          ]
        },
        "status": { "enum": ["pending", "active", "blocked", "completed"] },
        "blocked_reason": { "type": "string", "minLength": 1 },
        "principal": { "type": "number", "minimum": 0 },
        "term_rounds": { "type": "integer", "minimum": 1 },
        "rate_or_cost_bps": { "type": "number", "minimum": 0 },
        "cost_source": { "type": "string", "minLength": 1 },
        "covenant_min_cash": { "type": "number", "minimum": 0 },
        "fees": { "type": "number", "minimum": 0 },
        "obligation": {
          "enum": [
            "term_debt",
            "project_finance",
            "working_capital_revolver",
            "securitized_receivable",
            "equity"
          ]
        },
        "project_entry_id": { "type": ["string", "null"] },
        "initiative_id": { "type": ["string", "null"] },
        "policy_seam_id": { "type": ["string", "null"] },
        "created_round_no": { "type": "integer", "minimum": 1 },
        "effective_round_no": { "type": "integer", "minimum": 1 },
        "maturity_round_no": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
