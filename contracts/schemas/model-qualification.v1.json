{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/schemas/model-qualification.v1.json",
  "title": "SimWar source-backed model qualification",
  "oneOf": [
    { "$ref": "#/$defs/teacherProjection" },
    { "$ref": "#/$defs/adminProjection" },
    { "$ref": "#/$defs/studentProjection" }
  ],
  "$defs": {
    "adoptionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adoption_id", "adoption_digest"],
      "properties": {
        "adoption_id": {
          "type": "string",
          "minLength": 1
        },
        "adoption_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "adoptionEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "course_id",
        "source_package_id",
        "source_content_digest",
        "calibration_dataset_id",
        "calibration_dataset_content_digest",
        "qualification_id",
        "qualification_content_digest",
        "model_version_reference",
        "model_artifact_reference",
        "source_expires_at",
        "epoch_digest"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "course_id": {
          "type": "string",
          "minLength": 1
        },
        "source_package_id": {
          "type": "string",
          "minLength": 1
        },
        "source_content_digest": {
          "$ref": "#/$defs/digest"
        },
        "calibration_dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_dataset_content_digest": {
          "$ref": "#/$defs/digest"
        },
        "qualification_id": {
          "type": "string",
          "minLength": 1
        },
        "qualification_content_digest": {
          "$ref": "#/$defs/digest"
        },
        "model_version_reference": {
          "$ref": "#/$defs/modelVersionReference"
        },
        "model_artifact_reference": {
          "$ref": "#/$defs/artifact"
        },
        "source_expires_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
            },
            {
              "type": "null"
            }
          ]
        },
        "epoch_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "adoptionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_digest",
        "epoch",
        "expected_adoption",
        "requested_by",
        "requested_at"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "epoch": {
          "$ref": "#/$defs/adoptionEpoch"
        },
        "expected_adoption": {
          "anyOf": [
            {
              "$ref": "#/$defs/adoptionReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_by": {
          "type": "string",
          "minLength": 1
        },
        "requested_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        }
      }
    },
    "adoptionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "review_digest",
        "proposal_id",
        "proposal_digest",
        "decision",
        "note",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "review_digest": { "$ref": "#/$defs/digest" },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "decision": {
          "enum": ["APPROVED", "REJECTED"]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        }
      }
    },
    "adoptionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_id",
        "adoption_digest",
        "proposal_id",
        "proposal_digest",
        "review_id",
        "review_digest",
        "epoch",
        "predecessor",
        "disposition",
        "expires_at",
        "note",
        "decided_by",
        "decided_at",
        "official_truth_write",
        "provider"
      ],
      "properties": {
        "adoption_id": {
          "type": "string",
          "minLength": 1
        },
        "adoption_digest": {
          "$ref": "#/$defs/digest"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "review_digest": { "$ref": "#/$defs/digest" },
        "epoch": {
          "$ref": "#/$defs/adoptionEpoch"
        },
        "predecessor": {
          "anyOf": [
            {
              "$ref": "#/$defs/adoptionReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "enum": [
            "ADOPTED_FOR_FUTURE_ADMISSION",
            "DEFERRED_WITH_EXPIRY",
            "REJECTED_CANDIDATE",
            "REBASE_REQUIRED"
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "official_truth_write": {
          "const": false
        },
        "provider": {
          "const": "OFF"
        }
      }
    },
    "adoptionSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_version_reference",
        "model_artifact_reference",
        "adoption_id",
        "adoption_digest"
      ],
      "properties": {
        "model_version_reference": {
          "$ref": "#/$defs/modelVersionReference"
        },
        "model_artifact_reference": {
          "$ref": "#/$defs/artifact"
        },
        "adoption_id": {
          "type": "string",
          "minLength": 1
        },
        "adoption_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "adoptionCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "command_fingerprint", "actor_id", "action", "entity_id"],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "command_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": ["REQUEST", "REVIEW", "DISPOSE"]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adoptionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "course_id",
        "proposals",
        "reviews",
        "records",
        "selections",
        "commands"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "course_id": {
          "type": "string",
          "minLength": 1
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adoptionProposal"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adoptionReview"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adoptionRecord"
          }
        },
        "selections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adoptionSelection"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adoptionCommand"
          }
        }
      }
    },
    "governedRollbackRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rollback_request_id",
        "rollback_request_digest",
        "tenant_id",
        "course_id",
        "command_id",
        "command_fingerprint",
        "requested_by",
        "requested_role",
        "requested_at",
        "reason",
        "dry_run_id",
        "dry_run_digest",
        "current_adoption",
        "predecessor_adoption",
        "predecessor_epoch",
        "adoption_state_digest",
        "operations_policy_digest",
        "linked_proposal",
        "status",
        "current_selection_changed",
        "rollback_applied",
        "adoption_mutation",
        "official_truth_write",
        "history_deleted",
        "historical_receipt_rewritten",
        "provider"
      ],
      "properties": {
        "schema_version": { "const": "model-qualification-governed-rollback.v1" },
        "rollback_request_id": { "type": "string", "minLength": 1 },
        "rollback_request_digest": { "$ref": "#/$defs/digest" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "command_id": { "type": "string", "minLength": 1 },
        "command_fingerprint": { "$ref": "#/$defs/digest" },
        "requested_by": { "type": "string", "minLength": 1 },
        "requested_role": { "enum": ["teacher", "tenant_admin"] },
        "requested_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "reason": { "type": "string", "minLength": 1 },
        "dry_run_id": { "type": "string", "minLength": 1 },
        "dry_run_digest": { "$ref": "#/$defs/digest" },
        "current_adoption": { "$ref": "#/$defs/adoptionReference" },
        "predecessor_adoption": { "$ref": "#/$defs/adoptionReference" },
        "predecessor_epoch": { "$ref": "#/$defs/adoptionEpoch" },
        "adoption_state_digest": { "$ref": "#/$defs/digest" },
        "operations_policy_digest": { "$ref": "#/$defs/digest" },
        "linked_proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal_id", "proposal_digest"],
          "properties": {
            "proposal_id": { "type": "string", "minLength": 1 },
            "proposal_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "status": { "const": "LINKED_PROPOSAL_PENDING_REVIEW" },
        "current_selection_changed": { "const": false },
        "rollback_applied": { "const": false },
        "adoption_mutation": { "const": false },
        "official_truth_write": { "const": false },
        "history_deleted": { "const": false },
        "historical_receipt_rewritten": { "const": false },
        "provider": { "const": "OFF" }
      }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelVersionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "model_version_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "model_version_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_digest", "format", "source_ref"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "format": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "model_family", "model_version_reference", "status"],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "model_family": { "enum": ["toy_logit", "blp", "rcnl", "w5_governed", "custom"] },
        "model_version_reference": { "$ref": "#/$defs/modelVersionReference" },
        "status": { "enum": ["APPROVED", "RETIRED"] }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_count", "missingness_rate", "record_count"],
      "properties": {
        "conflict_count": { "type": "integer", "minimum": 0 },
        "missingness_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "record_count": { "type": "integer", "minimum": 1 }
      }
    },
    "sourcePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "course_id",
        "evidence_refs",
        "expires_at",
        "feature_schema_digest",
        "freshness_status",
        "observed_at",
        "quality",
        "rights_status",
        "source_package_id",
        "source_ref",
        "source_version",
        "tenant_id",
        "title"
      ],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_id": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expires_at": { "type": ["string", "null"] },
        "feature_schema_digest": { "$ref": "#/$defs/digest" },
        "freshness_status": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
        "observed_at": { "type": "string", "minLength": 1 },
        "quality": { "$ref": "#/$defs/quality" },
        "rights_status": { "enum": ["VALID", "EXPIRED", "UNKNOWN", "RESTRICTED"] },
        "source_package_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_version": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "evidence_refs",
        "expires_at",
        "feature_schema_digest",
        "freshness_status",
        "observed_at",
        "quality",
        "rights_status",
        "source_package_id",
        "source_ref",
        "source_version"
      ],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expires_at": { "type": ["string", "null"] },
        "feature_schema_digest": { "$ref": "#/$defs/digest" },
        "freshness_status": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
        "observed_at": { "type": "string", "minLength": 1 },
        "quality": { "$ref": "#/$defs/quality" },
        "rights_status": { "enum": ["VALID", "EXPIRED", "UNKNOWN", "RESTRICTED"] },
        "source_package_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_version": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_qualification_ids",
        "baseline",
        "candidate",
        "change_set_digest",
        "changed_dimensions",
        "course_id",
        "generated_at",
        "historical_non_overwrite",
        "tenant_id"
      ],
      "properties": {
        "affected_qualification_ids": { "type": "array", "items": { "type": "string" } },
        "baseline": { "$ref": "#/$defs/evidenceIdentity" },
        "candidate": { "$ref": "#/$defs/evidenceIdentity" },
        "change_set_digest": { "$ref": "#/$defs/digest" },
        "changed_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "content_digest",
              "source_ref",
              "source_version",
              "feature_schema_digest",
              "observed_at",
              "expires_at",
              "rights_status",
              "freshness_status",
              "quality",
              "evidence_refs"
            ]
          }
        },
        "course_id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "historical_non_overwrite": { "const": true },
        "tenant_id": { "type": "string", "minLength": 1 }
      }
    },
    "requalificationPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_set",
        "course_id",
        "created_at",
        "historical_non_overwrite",
        "known_limits",
        "preview_id",
        "reasons",
        "resolution",
        "review",
        "status",
        "tenant_id",
        "updated_at"
      ],
      "properties": {
        "change_set": { "$ref": "#/$defs/evidenceChangeSet" },
        "course_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "historical_non_overwrite": { "const": true },
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "preview_id": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "resolution": { "enum": ["PENDING", "ACCEPTED", "REJECTED"] },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "decision_note": { "type": "string" },
            "reviewed_at": { "type": "string" },
            "reviewed_by": { "type": "string" },
            "status": { "enum": ["PENDING", "APPROVED", "REJECTED"] }
          }
        },
        "status": {
          "enum": [
            "NO_CHANGE",
            "REQUALIFICATION_REQUIRED",
            "NOT_ELIGIBLE",
            "BLOCKED",
            "REBASE_REQUIRED"
          ]
        },
        "tenant_id": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_dataset_id",
        "calibration_record_ids",
        "content_digest",
        "course_id",
        "created_at",
        "holdout_leakage_count",
        "holdout_record_ids",
        "record_count",
        "source_package_id",
        "status",
        "tenant_id",
        "zero_holdout_leakage"
      ],
      "properties": {
        "calibration_dataset_id": { "type": "string", "minLength": 1 },
        "calibration_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "holdout_leakage_count": { "type": "integer", "minimum": 0 },
        "holdout_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "record_count": { "type": "integer", "minimum": 2 },
        "source_package_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["READY", "NOT_ELIGIBLE"] },
        "tenant_id": { "type": "string", "minLength": 1 },
        "zero_holdout_leakage": { "type": "boolean" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_error",
        "convergence_status",
        "differential_error",
        "drift_score",
        "ood_rate",
        "sensitivity_max_delta"
      ],
      "properties": {
        "baseline_error": { "type": "number", "minimum": 0 },
        "convergence_status": { "enum": ["CONVERGED", "NOT_CONVERGED"] },
        "differential_error": { "type": "number", "minimum": 0 },
        "drift_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "ood_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "sensitivity_max_delta": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "authority_flags",
        "binding",
        "calibration_dataset_id",
        "content_digest",
        "course_id",
        "created_at",
        "decision",
        "deterministic_seed",
        "diagnostics",
        "known_limits",
        "model_version_reference",
        "no_implicit_latest",
        "qualification_id",
        "reasons",
        "review",
        "source_package_id",
        "tenant_id",
        "updated_at"
      ],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "authority_flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official_truth_write", "provider_calls"],
          "properties": {
            "official_truth_write": { "const": false },
            "provider_calls": { "const": 0 }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "bound_at": { "type": "string" },
            "bound_by": { "type": "string" },
            "course_id": { "type": "string" },
            "status": { "enum": ["UNBOUND", "BOUND"] }
          }
        },
        "calibration_dataset_id": { "type": "string", "minLength": 1 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["APPROVED", "REJECTED", "NOT_ELIGIBLE"] },
        "deterministic_seed": { "type": "integer" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "model_version_reference": { "$ref": "#/$defs/modelVersionReference" },
        "no_implicit_latest": { "const": true },
        "qualification_id": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "decision_note": { "type": "string" },
            "reviewed_at": { "type": "string" },
            "reviewed_by": { "type": "string" },
            "status": { "enum": ["PENDING", "APPROVED", "REJECTED"] }
          }
        },
        "source_package_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "course", "role", "tenant"],
      "properties": {
        "activity": { "type": "string", "minLength": 1 },
        "course": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "tenant": { "type": "string", "minLength": 1 }
      }
    },
    "teacherProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_datasets",
        "known_limits",
        "model_catalog",
        "operation_id",
        "qualifications",
        "security",
        "source_packages"
      ],
      "properties": {
        "calibration_datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" } },
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "model_catalog": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/catalogEntry" }
        },
        "operation_id": { "const": "MODEL_QUALIFICATION_TEACHER_STUDIO_GET_V1" },
        "evidence_adoption": { "$ref": "#/$defs/adoptionState" },
        "governed_rollback_requests": {
          "type": "array",
          "items": { "$ref": "#/$defs/governedRollbackRequest" }
        },
        "qualifications": { "type": "array", "items": { "$ref": "#/$defs/qualification" } },
        "requalification_previews": {
          "type": "array",
          "items": { "$ref": "#/$defs/requalificationPreview" }
        },
        "security": { "$ref": "#/$defs/security" },
        "source_packages": { "type": "array", "items": { "$ref": "#/$defs/sourcePackage" } }
      }
    },
    "adminProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "calibration_datasets",
        "known_limits",
        "model_catalog",
        "operation_id",
        "qualifications",
        "security",
        "source_packages"
      ],
      "properties": {
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ai_provider",
            "formal_truth_writer",
            "model_governance_writer",
            "repository_provider",
            "writes_formal_truth"
          ],
          "properties": {
            "ai_provider": { "const": "OFF" },
            "formal_truth_writer": { "const": "SIMULATION_CORE" },
            "model_governance_writer": { "const": "MAIN_MODEL_GOVERNANCE" },
            "repository_provider": { "const": "JSON_INTERNAL_ONLY" },
            "writes_formal_truth": { "const": false }
          }
        },
        "calibration_datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" } },
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "model_catalog": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/catalogEntry" }
        },
        "operation_id": { "const": "MODEL_QUALIFICATION_ADMIN_AUDIT_GET_V1" },
        "evidence_adoption": { "$ref": "#/$defs/adoptionState" },
        "governed_rollback_requests": {
          "type": "array",
          "items": { "$ref": "#/$defs/governedRollbackRequest" }
        },
        "qualifications": { "type": "array", "items": { "$ref": "#/$defs/qualification" } },
        "requalification_previews": {
          "type": "array",
          "items": { "$ref": "#/$defs/requalificationPreview" }
        },
        "security": { "$ref": "#/$defs/security" },
        "source_packages": { "type": "array", "items": { "$ref": "#/$defs/sourcePackage" } }
      }
    },
    "studentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_limits", "operation_id", "qualification", "security", "visibility"],
      "properties": {
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "operation_id": { "const": "MODEL_QUALIFICATION_STUDENT_PROJECTION_GET_V1" },
        "adoption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability",
            "historical_non_overwrite",
            "provider",
            "official_truth_write",
            "known_limits"
          ],
          "properties": {
            "applicability": {
              "enum": [
                "ADOPTED_FOR_FUTURE_ADMISSION",
                "HISTORICAL_ONLY",
                "NOT_ADOPTED",
                "UNAVAILABLE"
              ]
            },
            "historical_non_overwrite": { "const": true },
            "provider": { "const": "OFF" },
            "official_truth_write": { "const": false },
            "known_limits": { "type": "array", "items": { "type": "string" } }
          }
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding_status",
            "decision",
            "diagnostics",
            "explanation",
            "model_family",
            "model_version",
            "qualification_id",
            "review_status",
            "source"
          ],
          "properties": {
            "binding_status": { "enum": ["UNBOUND", "BOUND"] },
            "decision": { "enum": ["APPROVED", "REJECTED", "NOT_ELIGIBLE"] },
            "diagnostics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "convergence_status",
                "drift_score",
                "holdout_leakage_count",
                "ood_rate",
                "sensitivity_max_delta"
              ],
              "properties": {
                "convergence_status": { "enum": ["CONVERGED", "NOT_CONVERGED"] },
                "drift_score": { "type": "number" },
                "holdout_leakage_count": { "type": "integer", "minimum": 0 },
                "ood_rate": { "type": "number" },
                "sensitivity_max_delta": { "type": "number" }
              }
            },
            "explanation": { "type": "array", "items": { "type": "string" } },
            "model_family": { "type": "string", "minLength": 1 },
            "model_version": { "type": "string", "minLength": 1 },
            "qualification_id": { "type": "string", "minLength": 1 },
            "review_status": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["freshness_status", "rights_status", "source_version", "title"],
              "properties": {
                "freshness_status": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
                "rights_status": { "enum": ["VALID", "EXPIRED", "UNKNOWN", "RESTRICTED"] },
                "source_version": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "requalification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "historical_non_overwrite",
            "known_limits",
            "resolution",
            "review_status",
            "status"
          ],
          "properties": {
            "historical_non_overwrite": { "const": true },
            "known_limits": { "type": "array", "items": { "type": "string" } },
            "resolution": { "enum": ["PENDING", "ACCEPTED", "REJECTED"] },
            "review_status": { "enum": ["PENDING", "APPROVED", "REJECTED"] },
            "status": {
              "enum": [
                "NO_CHANGE",
                "REQUALIFICATION_REQUIRED",
                "NOT_ELIGIBLE",
                "BLOCKED",
                "REBASE_REQUIRED"
              ]
            }
          }
        },
        "security": { "$ref": "#/$defs/security" },
        "visibility": { "const": "ROLE_SAFE_STUDENT" }
      }
    }
  }
}
