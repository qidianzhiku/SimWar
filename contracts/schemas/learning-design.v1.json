{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/learning-design.v1.json",
  "title": "SimWar D1 Learning Design",
  "type": "object",
  "additionalProperties": false,
  "required": ["learning_goals", "rubrics"],
  "properties": {
    "learning_goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/goal" }
    },
    "rubrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/rubric" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": {
      "type": "string",
      "pattern": "^(?!.*(?:any|current|default|fallback|latest|next|unresolved))(?!.*(?:ANY|CURRENT|DEFAULT|FALLBACK|LATEST|NEXT|UNRESOLVED))[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?!.*(?:[._:-][xX*])(?:$|[._:-]))[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "coursePackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "course_package_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_package_id": { "$ref": "#/$defs/identity" },
        "tenant_id": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "goalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "goal_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "goal_id": { "$ref": "#/$defs/identity" },
        "tenant_id": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "activityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "content_digest", "version"],
      "properties": {
        "activity_id": { "$ref": "#/$defs/identity" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_refs",
        "content_digest",
        "course_package_reference",
        "created_at",
        "created_by",
        "expected_evidence_classes",
        "goal_id",
        "observable_behaviors",
        "role_scope",
        "schema_version",
        "statement",
        "status",
        "tenant_id",
        "title",
        "version"
      ],
      "properties": {
        "activity_refs": { "type": "array", "items": { "$ref": "#/$defs/activityRef" } },
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_package_reference": { "$ref": "#/$defs/coursePackageRef" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "created_by": { "$ref": "#/$defs/identity" },
        "expected_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identity" }
        },
        "goal_id": { "$ref": "#/$defs/identity" },
        "observable_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "role_scope": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identity" } },
        "schema_version": { "const": "learning-design.v1" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "REJECTED"] },
        "supersedes_ref": { "$ref": "#/$defs/goalRef" },
        "tenant_id": { "$ref": "#/$defs/identity" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "label", "ordinal"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/identity" },
        "ordinal": { "type": "integer", "minimum": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "levels", "prompt"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identity" },
        "levels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/level" } },
        "prompt": { "type": "string", "minLength": 1 }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "course_package_reference",
        "created_at",
        "created_by",
        "criteria",
        "learning_goal_references",
        "rubric_id",
        "schema_version",
        "scoring_policy",
        "status",
        "tenant_id",
        "title",
        "version"
      ],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_package_reference": { "$ref": "#/$defs/coursePackageRef" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "created_by": { "$ref": "#/$defs/identity" },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
        "learning_goal_references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/goalRef" }
        },
        "rubric_id": { "$ref": "#/$defs/identity" },
        "schema_version": { "const": "learning-design.v1" },
        "scoring_policy": { "const": "NOT_ACTIVE_D1" },
        "status": { "enum": ["DRAFT", "VALIDATED", "PUBLISHED", "REJECTED"] },
        "supersedes_ref": { "$ref": "#/$defs/rubricRef" },
        "tenant_id": { "$ref": "#/$defs/identity" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "rubricRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "rubric_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "rubric_id": { "$ref": "#/$defs/identity" },
        "tenant_id": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/version" }
      }
    }
  }
}
