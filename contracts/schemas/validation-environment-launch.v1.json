{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.internal/contracts/validation-environment-launch.v1.json",
  "title": "ValidationEnvironmentLaunch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "launch_id",
    "tenant_id",
    "business_key_digest",
    "request_fingerprint",
    "status",
    "source_parameter_set",
    "source_scenario_package",
    "course_blueprint_reference",
    "course_package_reference",
    "step_receipts",
    "version",
    "created_by",
    "created_at",
    "updated_at",
    "known_limits"
  ],
  "properties": {
    "schema_version": { "const": "validation-environment-launch.v1" },
    "launch_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "business_key_digest": { "$ref": "#/$defs/digest" },
    "request_fingerprint": { "$ref": "#/$defs/digest" },
    "status": {
      "enum": [
        "REQUESTED",
        "BASELINE_READY",
        "COURSE_RUN_READY",
        "COHORT_READY",
        "SESSION_PREFLIGHT_READY",
        "READY",
        "CONFLICT",
        "ABORTED"
      ]
    },
    "source_parameter_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "reference"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "reference": { "$ref": "#/$defs/parameterRef" }
      }
    },
    "source_scenario_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "reference"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "reference": { "$ref": "#/$defs/scenarioRef" }
      }
    },
    "course_blueprint_reference": { "$ref": "#/$defs/blueprintRef" },
    "course_package_reference": { "$ref": "#/$defs/packageRef" },
    "step_receipts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": { "$ref": "#/$defs/receipt" },
        "course_run": { "$ref": "#/$defs/receipt" },
        "cohort": { "$ref": "#/$defs/receipt" },
        "session": { "$ref": "#/$defs/receipt" }
      }
    },
    "course_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "round_id": { "type": "string", "minLength": 1 },
    "team_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "session_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 0 },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_error": { "type": "string" },
    "known_limits": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parameterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "parameter_set_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "parameter_set_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "scenarioRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "scenario_package_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "scenario_package_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "blueprintRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "course_blueprint_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_blueprint_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "course_package_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "$ref": "#/$defs/digest" },
        "course_package_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_at", "digest", "status", "summary"],
      "properties": {
        "completed_at": { "type": "string", "format": "date-time" },
        "digest": { "$ref": "#/$defs/digest" },
        "status": { "const": "PASS" },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
