              "covenant_status": { "const": "BREACHED" },
              "binding_constraints": {
                "type": "array",
                "contains": { "const": "COVENANT_MIN_CASH_BREACH" }
              },
              "feasibility": { "const": "INFEASIBLE" }
            }
          }
        },
        {
          "if": {
            "required": ["feasibility"],
            "properties": { "feasibility": { "const": "FEASIBLE" } }
          },
          "then": {
            "properties": {
              "covenant_status": { "const": "WITHIN_LIMIT" },
              "binding_constraints": { "const": [] },
              "why_not_feasible": { "const": [] }
            }
          }
        },
        {
          "if": {
            "required": ["feasibility"],
            "properties": { "feasibility": { "const": "INFEASIBLE" } }
          },
          "then": {
            "properties": {
              "binding_constraints": { "type": "array", "minItems": 1 },
              "why_not_feasible": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "required": ["feasibility"],
            "properties": { "feasibility": { "const": "UNKNOWN" } }
          },
          "then": {
            "properties": {
              "binding_constraints": { "type": "array", "minItems": 1 },
              "why_not_feasible": { "type": "array", "minItems": 1 }
            }
          }
        }
