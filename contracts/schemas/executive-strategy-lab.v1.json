        "feasibility": { "enum": ["FEASIBLE", "INFEASIBLE", "UNKNOWN"] },
        "binding_constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "why_not_feasible": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
