{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/project-profile.v1.json",
  "title": "Project Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "course_id",
    "content_digest",
    "created_at",
    "created_by",
    "customer_segment",
    "description",
    "geography",
    "industry",
    "market_world_reference",
    "positioning",
    "project_profile_id",
    "provenance",
    "schema_version",
    "service_bundle",
    "starting_capacity",
    "starting_cash",
    "status",
    "template_id",
    "tenant_id",
    "title",
    "version"
  ],
  "properties": {
    "course_id": { "type": "string", "minLength": 1 },
    "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "customer_segment": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "future_effective_at": { "type": "string", "format": "date-time" },
    "geography": { "type": "string", "minLength": 1 },
    "industry": { "type": "string", "minLength": 1 },
    "market_world_reference": {
      "$ref": "#/$defs/marketWorldRef"
    },
    "positioning": { "type": "string", "minLength": 1 },
    "project_profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["APPROVED_SAFE_TEMPLATE", "NORMALIZED_IMPORT", "CLONED", "SUCCESSOR"]
        },
        "source_project_profile_reference": { "$ref": "#/$defs/projectProfileRef" }
      }
    },
    "schema_version": { "const": "project-profile.v1" },
    "service_bundle": { "type": "string", "minLength": 1 },
    "starting_capacity": { "type": "number", "minimum": 0 },
    "starting_cash": { "type": "number", "minimum": 0 },
    "status": { "enum": ["DRAFT", "VALIDATED", "RETIRED"] },
    "successor_of": { "$ref": "#/$defs/projectProfileRef" },
    "template_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[.-][A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  },
  "$defs": {
    "marketWorldRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "market_world_id", "version"],
      "properties": {
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "market_world_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "projectProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "project_profile_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "project_profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[.-][A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    }
  }
}
