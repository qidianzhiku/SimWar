{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/project-assignment.v1.json",
  "title": "Project Assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assigned_at",
    "assigned_by",
    "assignment_id",
    "course_id",
    "project_profile_reference",
    "run_id",
    "schema_version",
    "team_id",
    "tenant_id"
  ],
  "properties": {
    "assigned_at": { "type": "string", "format": "date-time" },
    "assigned_by": { "type": "string", "minLength": 1 },
    "assignment_id": { "type": "string", "minLength": 1 },
    "course_id": { "type": "string", "minLength": 1 },
    "project_profile_reference": { "$ref": "#/$defs/projectProfileRef" },
    "run_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "project-assignment.v1" },
    "team_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "projectProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "project_profile_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "project_profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[.-][A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    }
  }
}
