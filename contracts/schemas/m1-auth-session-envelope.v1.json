{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/m1-auth-session-envelope.v1.json",
  "title": "M1AuthSessionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "code", "message", "data"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "code": { "const": "OK" },
    "message": { "type": "string", "minLength": 1 },
    "data": { "$ref": "#/$defs/authSession" }
  },
  "$defs": {
    "authSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_token", "expires_in", "token_type", "user"],
      "properties": {
        "access_token": { "type": "string", "minLength": 32 },
        "expires_in": { "type": "integer", "minimum": 1 },
        "token_type": { "const": "Bearer" },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_id", "tenant_id", "display_name", "roles"],
          "properties": {
            "user_id": { "type": "string", "minLength": 1 },
            "tenant_id": { "type": "string", "minLength": 1 },
            "display_name": { "type": "string", "minLength": 1 },
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "permissions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "team_id": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
