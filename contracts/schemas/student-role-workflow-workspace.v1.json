{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/student-role-workflow-workspace.v1.json",
  "title": "Student Role Workflow Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context", "assignment"],
  "properties": {
    "schema_version": { "const": "student-role-workflow-workspace.v1" },
    "market_world_visibility": {
      "enum": ["PRE_VISIBILITY", "VISIBLE", "STALE", "UNKNOWN"]
    },
    "market_brief": {
      "$ref": "#/$defs/studentMarketBrief"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_context_id",
        "tenant_id",
        "user_id",
        "course_id",
        "run_id",
        "round_id",
        "round_no",
        "team_id",
        "assignment_id",
        "role_key",
        "role_template_id",
        "permissions",
        "source",
        "expires_at"
      ],
      "properties": {
        "role_context_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "round_no": { "type": "integer", "minimum": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "assignment_id": { "type": "string", "minLength": 1 },
        "role_key": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
        "role_template_id": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "role_key",
            "schema_version",
            "can_read_role_workspace",
            "can_save_section",
            "can_mark_ready",
            "can_create_merge_commit",
            "can_confirm_team_decision",
            "can_submit_canonical_decision",
            "editable_fields",
            "visible_scopes",
            "advisory_scopes"
          ],
          "properties": {
            "policy_id": { "type": "string" },
            "role_key": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
            "schema_version": { "const": "role-permission-policy.v1" },
            "can_read_role_workspace": { "type": "boolean" },
            "can_save_section": { "type": "boolean" },
            "can_mark_ready": { "type": "boolean" },
            "can_create_merge_commit": { "type": "boolean" },
            "can_confirm_team_decision": { "type": "boolean" },
            "can_submit_canonical_decision": { "type": "boolean" },
            "editable_fields": {
              "type": "array",
              "items": {
                "enum": [
                  "pricing.base_price",
                  "marketing_budget",
                  "service_quality_budget",
                  "capacity_plan",
                  "cash_buffer_target",
                  "strategy_statement"
                ]
              }
            },
            "visible_scopes": { "type": "array", "items": { "type": "string" } },
            "advisory_scopes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "source": { "const": "resolved_from_assignment" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "tenant_id",
        "course_id",
        "run_id",
        "team_id",
        "user_id",
        "role_key",
        "role_template_id",
        "status",
        "source",
        "assigned_at"
      ],
      "properties": {
        "assignment_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "team_id": { "type": "string" },
        "user_id": { "type": "string" },
        "role_key": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
        "role_template_id": { "type": "string" },
        "status": { "enum": ["active", "inactive"] },
        "source": { "enum": ["teacher_assigned", "seeded_default"] },
        "assigned_at": { "type": "string", "format": "date-time" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "tenant_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "status",
        "payload",
        "version",
        "submitted_by",
        "submitted_at",
        "updated_at"
      ],
      "properties": {
        "section_id": { "type": "string" },
        "assignment_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "role_key": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
        "status": { "enum": ["draft", "ready"] },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pricing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["base_price"],
              "properties": { "base_price": { "type": "number" } }
            },
            "marketing_budget": { "type": "number" },
            "service_quality_budget": { "type": "number" },
            "capacity_plan": { "enum": ["contract", "hold", "expand"] },
            "cash_buffer_target": { "type": "number" },
            "strategy_statement": { "type": "string" }
          }
        },
        "version": { "type": "integer", "minimum": 1 },
        "submitted_by": { "type": "string" },
        "submitted_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "merge_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge_commit_id", "status", "created_at"],
      "properties": {
        "merge_commit_id": { "type": "string" },
        "status": { "const": "validated" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_at"],
      "properties": {
        "status": { "const": "confirmed" },
        "confirmed_at": { "type": "string", "format": "date-time" }
      }
    },
    "divergence_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "run_id",
        "round_id",
        "team_id",
        "status",
        "source_section_ids",
        "source_digest",
        "divergences",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "team-divergence-set.v1" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["NONE", "OPEN", "RESOLVED"] },
        "source_section_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "divergences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["divergence_id", "field", "status", "candidates"],
            "properties": {
              "divergence_id": { "type": "string", "minLength": 1 },
              "field": {
                "enum": [
                  "pricing.base_price",
                  "marketing_budget",
                  "service_quality_budget",
                  "capacity_plan",
                  "cash_buffer_target",
                  "strategy_statement"
                ]
              },
              "status": { "enum": ["OPEN", "RESOLVED"] },
              "candidates": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role_key", "source_section_id", "value"],
                  "properties": {
                    "role_key": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
                    "source_section_id": { "type": "string", "minLength": 1 },
                    "value": { "type": ["number", "string"] }
                  }
                }
              }
            }
          }
        },
        "known_limits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "team_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "tenant_id",
        "run_id",
        "round_id",
        "team_id",
        "status",
        "source_section_ids",
        "source_digest",
        "selected_values",
        "proposed_at"
      ],
      "properties": {
        "resolution_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "status": { "const": "PROPOSED" },
        "source_section_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "selected_values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pricing.base_price": { "type": ["number", "string"] },
            "marketing_budget": { "type": ["number", "string"] },
            "service_quality_budget": { "type": ["number", "string"] },
            "capacity_plan": { "type": ["number", "string"] },
            "cash_buffer_target": { "type": ["number", "string"] },
            "strategy_statement": { "type": ["number", "string"] }
          }
        },
        "proposed_at": { "type": "string", "format": "date-time" }
      }
    },
    "resolution_acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acknowledgement_id",
          "resolution_id",
          "tenant_id",
          "run_id",
          "round_id",
          "team_id",
          "role_key",
          "status",
          "acknowledged_at"
        ],
        "properties": {
          "acknowledgement_id": { "type": "string", "minLength": 1 },
          "resolution_id": { "type": "string", "minLength": 1 },
          "tenant_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "round_id": { "type": "string", "minLength": 1 },
          "team_id": { "type": "string", "minLength": 1 },
          "role_key": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
          "status": { "enum": ["ACKNOWLEDGED", "DISSENT_PRESERVED"] },
          "dissent_note": { "type": "string", "minLength": 1, "maxLength": 280 },
          "acknowledged_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "marketWorldRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_world_id", "version", "digest"],
      "properties": {
        "market_world_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.m[0-9]+\\.[0-9]+$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessed_at", "source_freshness", "status"],
      "properties": {
        "assessed_at": { "type": "string", "format": "date-time" },
        "source_freshness": { "enum": ["PROJECT_ANCHOR", "UNKNOWN"] },
        "status": { "enum": ["CURRENT", "STALE", "UNKNOWN"] }
      }
    },
    "studentMarketBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "brief_kind",
        "visibility_state",
        "market_world_reference",
        "market_world_name",
        "market_structure",
        "customer_tensions",
        "service_landscape",
        "outside_options",
        "archetype_context",
        "key_business_tensions",
        "freshness",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "student-market-brief.v1" },
        "brief_kind": { "const": "SHANGHAI_MARKET_BRIEF" },
        "visibility_state": { "const": "VISIBLE" },
        "market_world_reference": { "$ref": "#/$defs/marketWorldRef" },
        "market_world_name": { "type": "string", "minLength": 1 },
        "market_structure": { "type": "string", "minLength": 1 },
        "customer_tensions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "service_landscape": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "outside_options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "archetype_context": { "type": "string", "minLength": 1 },
        "key_business_tensions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "freshness": { "$ref": "#/$defs/freshness" },
        "known_limits": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
