{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simwar.local/contracts/w5-governed-model.v1.json",
  "title": "SimWar W5 Governed Model",
  "oneOf": [
    { "$ref": "#/$defs/teacherProjection" },
    { "$ref": "#/$defs/studentProjection" },
    { "$ref": "#/$defs/convergence" },
    { "$ref": "#/$defs/adminProjection" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "demandCandidateProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_share", "product_id"],
      "properties": {
        "candidate_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "product_id": { "type": "string", "minLength": 1 }
      }
    },
    "demandCandidateMarket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_id", "outside_option_share", "products"],
      "properties": {
        "market_id": { "type": "string", "minLength": 1 },
        "outside_option_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/demandCandidateProduct" }
        }
      }
    },
    "demandCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_flags",
        "candidate_digest",
        "consumer_binding_digest",
        "exact_binding",
        "feature_ownership",
        "market_count",
        "market_ids",
        "markets",
        "model_family",
        "model_version_id",
        "source_plane",
        "status"
      ],
      "properties": {
        "authority_flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official_truth_write", "provider_calls", "settlement_write"],
          "properties": {
            "official_truth_write": { "const": false },
            "provider_calls": { "const": 0 },
            "settlement_write": { "const": false }
          }
        },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "consumer_binding_digest": { "$ref": "#/$defs/digest" },
        "exact_binding": { "const": true },
        "feature_ownership": {
          "type": "array",
          "items": { "enum": ["ideal_lancaster_fit", "huff_spatial_weight"] },
          "minItems": 2,
          "maxItems": 2
        },
        "market_count": { "type": "integer", "minimum": 0 },
        "market_ids": { "type": "array", "minItems": 0, "items": { "type": "string" } },
        "markets": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/demandCandidateMarket" }
        },
        "model_family": { "const": "IDEAL_POINT_LANCASTER_HUFF_SPATIAL" },
        "model_version_id": { "type": "string", "minLength": 1 },
        "source_plane": { "const": "GOVERNED_DEMAND_CANDIDATE" },
        "status": { "enum": ["FALLBACK", "PASS"] }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity",
        "actor",
        "course",
        "dimensions",
        "role",
        "round",
        "run",
        "team",
        "tenant"
      ],
      "properties": {
        "activity": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "course": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "enforcement_point",
              "evidence_ref",
              "negative_test",
              "status",
              "value"
            ],
            "properties": {
              "dimension": { "type": "string" },
              "enforcement_point": { "type": "string" },
              "evidence_ref": { "type": "string" },
              "negative_test": { "type": "string" },
              "status": { "enum": ["PASS", "N/A", "LIMIT"] },
              "value": {}
            }
          }
        },
        "role": { "type": "string" },
        "round": { "type": ["integer", "null"] },
        "run": { "type": ["string", "null"] },
        "team": { "type": ["string", "null"] },
        "tenant": { "type": "string", "minLength": 1 }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "default",
        "key",
        "label",
        "mapping_readiness",
        "source",
        "type",
        "unit",
        "visibility"
      ],
      "properties": {
        "consumer": { "type": "string" },
        "default": {},
        "key": { "type": "string" },
        "label": { "type": "string" },
        "mapping_readiness": { "enum": ["READY", "DRAFT"] },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max", "min"],
          "properties": { "max": { "type": "number" }, "min": { "type": "number" } }
        },
        "source": { "type": "string" },
        "type": { "enum": ["boolean", "enum", "number", "string"] },
        "unit": { "type": "string" },
        "visibility": { "enum": ["advanced", "standard", "teacher"] }
      }
    },
    "featureOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_meaning",
        "feature_id",
        "primary_producer",
        "source_ref",
        "unit",
        "visibility"
      ],
      "properties": {
        "economic_meaning": { "type": "string" },
        "feature_id": { "type": "string" },
        "primary_producer": { "type": "string" },
        "source_ref": { "type": "string" },
        "unit": { "type": "string" },
        "visibility": { "enum": ["approved_view", "internal", "shadow"] }
      }
    },
    "modelFamilyReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_claim",
        "classification",
        "family",
        "invocation_proven",
        "known_limit"
      ],
      "properties": {
        "activation_claim": {
          "enum": [
            "CURRENT_CORE",
            "SYNTHETIC_HEURISTIC",
            "SHADOW",
            "RESEARCH",
            "MISSING",
            "DEFERRED"
          ]
        },
        "classification": {
          "enum": [
            "CURRENT",
            "APPROVED_BASELINE",
            "SHADOW",
            "RESEARCH",
            "MISSING",
            "STALE",
            "DEFERRED",
            "NOT_CALIBRATED"
          ]
        },
        "family": { "type": "string", "minLength": 1 },
        "invocation_proven": { "type": "boolean" },
        "known_limit": { "type": "string", "minLength": 1 }
      }
    },
    "modelVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_at",
        "engine_reference",
        "feature_ownership",
        "fallback",
        "model_family",
        "model_family_readiness",
        "model_version_ref",
        "no_implicit_latest",
        "status",
        "visibility"
      ],
      "properties": {
        "approved_at": { "type": "string" },
        "engine_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine_id", "version"],
          "properties": { "engine_id": { "type": "string" }, "version": { "type": "string" } }
        },
        "feature_ownership": { "type": "array", "items": { "$ref": "#/$defs/featureOwnership" } },
        "model_family_readiness": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelFamilyReadiness" },
          "minItems": 1
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic_plane", "mode", "official_path_continues"],
          "properties": {
            "deterministic_plane": { "type": "string" },
            "mode": { "const": "PLANE_OFF" },
            "official_path_continues": { "const": true }
          }
        },
        "model_family": { "type": "string" },
        "model_version_ref": { "const": "eldercare_w5_governed_v1@1.1.0" },
        "no_implicit_latest": { "const": true },
        "status": { "const": "APPROVED" },
        "visibility": { "type": "object" }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_id",
        "created_by",
        "data_classification",
        "draft_id",
        "exact_runtime_binding",
        "model_version_ref",
        "parameter_descriptors",
        "parameter_values",
        "seed",
        "status",
        "tenant_id",
        "title",
        "updated_at"
      ],
      "properties": {
        "course_id": { "type": "string" },
        "created_by": { "type": "string" },
        "data_classification": { "enum": ["REALITY", "SYNTHETIC", "ASSUMPTION", "STRESS_TEST"] },
        "draft_id": { "type": "string" },
        "exact_runtime_binding": { "type": ["object", "null"] },
        "model_version_ref": { "const": "eldercare_w5_governed_v1@1.1.0" },
        "parameter_descriptors": { "type": "array", "items": { "$ref": "#/$defs/descriptor" } },
        "parameter_values": { "type": "object" },
        "seed": { "type": "integer" },
        "status": { "enum": ["DRAFT", "VALIDATED", "FROZEN", "BOUND"] },
        "tenant_id": { "type": "string" },
        "title": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can",
        "demand_realization",
        "experience_profile",
        "fallback",
        "known_limits",
        "model_version_ref",
        "provenance",
        "realized",
        "replay",
        "security",
        "shadow",
        "want"
      ],
      "properties": {
        "can": { "type": "object" },
        "demand_realization": { "$ref": "#/$defs/demandRealization" },
        "experience_profile": { "enum": ["STANDARD", "ADVANCED"] },
        "fallback": { "type": "object" },
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "model_version_ref": { "const": "eldercare_w5_governed_v1@1.1.0" },
        "provenance": { "type": "object" },
        "realized": { "type": "object" },
        "replay": { "type": "object" },
        "security": { "$ref": "#/$defs/security" },
        "shadow": { "type": "object" },
        "want": { "type": "object" }
      }
    },
    "demandRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "explanation", "known_limits", "lineage", "mechanism", "readiness"],
      "properties": {
        "candidate": { "$ref": "#/$defs/demandCandidate" },
        "readiness": { "const": "READY_WITH_LIMITS" },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data_classification", "exact_binding", "model_version_ref", "round_no"],
          "properties": {
            "data_classification": {
              "enum": ["REALITY", "SYNTHETIC", "ASSUMPTION", "STRESS_TEST"]
            },
            "exact_binding": { "const": true },
            "model_version_ref": { "const": "eldercare_w5_governed_v1@1.1.0" },
            "round_no": { "type": "integer", "minimum": 1 }
          }
        },
        "mechanism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["can", "realized", "want"],
          "properties": {
            "want": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_value", "official", "source_plane"],
              "properties": {
                "candidate_value": { "type": "number", "minimum": 0 },
                "official": { "const": false },
                "source_plane": { "const": "SYNTHETIC_HEURISTIC" }
              }
            },
            "can": {
              "type": "object",
              "additionalProperties": false,
              "required": ["constraints", "eligible", "official", "source_plane"],
              "properties": {
                "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "eligible": { "type": "boolean" },
                "official": { "const": false },
                "source_plane": { "const": "CAPACITY_WORKFORCE_QUALITY_ELIGIBILITY" }
              }
            },
            "realized": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "authority",
                "official",
                "replay_relevant_digest",
                "writes_formal_result"
              ],
              "properties": {
                "authority": { "const": "SIMULATION_CORE" },
                "official": { "const": true },
                "replay_relevant_digest": { "$ref": "#/$defs/digest" },
                "writes_formal_result": { "const": false }
              }
            }
          }
        },
        "explanation": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["official", "stage", "summary"],
            "properties": {
              "official": { "type": "boolean" },
              "stage": { "enum": ["WANT", "CAN", "REALIZED"] },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "teacherProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_limits",
        "model_version",
        "operation_id",
        "parameter_descriptors",
        "drafts",
        "security"
      ],
      "properties": {
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "model_version": { "$ref": "#/$defs/modelVersion" },
        "operation_id": { "const": "W5_TEACHER_GOVERNED_MODEL_STUDIO_GET_V1" },
        "parameter_descriptors": { "type": "array", "items": { "$ref": "#/$defs/descriptor" } },
        "drafts": { "type": "array", "items": { "$ref": "#/$defs/draft" } },
        "security": { "$ref": "#/$defs/security" }
      }
    },
    "adminProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "known_limits",
        "model_version",
        "operation_id",
        "parameter_descriptors",
        "drafts",
        "security"
      ],
      "properties": {
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ai_provider",
            "formal_truth_writer",
            "repository_provider",
            "writes_formal_truth"
          ],
          "properties": {
            "ai_provider": { "const": "OFF" },
            "formal_truth_writer": { "const": "SIMULATION_CORE" },
            "repository_provider": { "const": "JSON_INTERNAL_ONLY" },
            "writes_formal_truth": { "const": false }
          }
        },
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "model_version": { "$ref": "#/$defs/modelVersion" },
        "operation_id": { "const": "W5_ADMIN_GOVERNED_MODEL_AUDIT_GET_V1" },
        "parameter_descriptors": { "type": "array", "items": { "$ref": "#/$defs/descriptor" } },
        "drafts": { "type": "array", "items": { "$ref": "#/$defs/draft" } },
        "security": { "$ref": "#/$defs/security" }
      }
    },
    "studentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["convergence", "operation_id", "security", "visibility"],
      "properties": {
        "convergence": { "$ref": "#/$defs/studentConvergence" },
        "operation_id": { "const": "W5_STUDENT_GOVERNED_MODEL_PROJECTION_GET_V1" },
        "security": { "$ref": "#/$defs/security" },
        "visibility": { "const": "ROLE_SAFE_STUDENT" }
      }
    },
    "studentConvergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can",
        "demand_realization",
        "experience_profile",
        "fallback",
        "known_limits",
        "model_version_ref",
        "realized",
        "replay",
        "shadow",
        "want"
      ],
      "properties": {
        "can": { "type": "object" },
        "demand_realization": { "$ref": "#/$defs/demandRealization" },
        "experience_profile": { "enum": ["STANDARD", "ADVANCED"] },
        "fallback": { "type": "object" },
        "known_limits": { "type": "array", "items": { "type": "string" } },
        "model_version_ref": { "const": "eldercare_w5_governed_v1@1.1.0" },
        "realized": { "type": "object" },
        "replay": { "type": "object" },
        "shadow": { "type": "object" },
        "want": { "type": "object" }
      }
    }
  }
}
