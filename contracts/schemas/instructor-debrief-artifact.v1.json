{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/instructor-debrief-artifact.v1.json",
  "title": "Teacher Instructor Debrief Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ai_status",
    "artifact_digest",
    "artifact_schema_version",
    "artifact_type",
    "authority_class",
    "exactness_limits",
    "instructor_asset_fact_digest",
    "instructor_asset_id",
    "kit",
    "source_binding"
  ],
  "properties": {
    "ai_status": { "const": "off" },
    "artifact_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact_schema_version": { "const": "instructor-debrief-artifact.v1" },
    "artifact_type": { "const": "instructor_debrief_artifact" },
    "authority_class": { "const": "ADVISORY_ONLY" },
    "exactness_limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "instructor_asset_fact_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "instructor_asset_id": { "type": "string", "minLength": 1 },
    "kit": { "$ref": "instructor-intelligence-kit.v1.json" },
    "source_binding": { "$ref": "#/$defs/source_binding" }
  },
  "$defs": {
    "exact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "discriminator",
        "resource_id",
        "resource_type",
        "tenant_id",
        "version"
      ],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "discriminator": { "const": "exact_ref" },
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_type": { "const": "course_blueprint" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "baseline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "round_id",
            "round_no",
            "replay_hash",
            "run_id",
            "settlement_result_id",
            "status"
          ],
          "properties": {
            "round_id": { "type": "string", "minLength": 1 },
            "round_no": { "type": "integer", "minimum": 1 },
            "replay_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "run_id": { "type": "string", "minLength": 1 },
            "settlement_result_id": { "type": "string", "minLength": 1 },
            "status": { "const": "available" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "status"],
          "properties": {
            "reason": { "const": "NO_PRIOR_PUBLISHED_RESULT" },
            "status": { "const": "baseline_unavailable" }
          }
        }
      ]
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "course_blueprint_ref",
        "instructor_asset_fact_digest",
        "instructor_asset_id",
        "replay_hash",
        "round_id",
        "round_no",
        "run_id",
        "settlement_result_id"
      ],
      "properties": {
        "baseline": { "$ref": "#/$defs/baseline" },
        "course_blueprint_ref": { "$ref": "#/$defs/exact_ref" },
        "instructor_asset_fact_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "instructor_asset_id": { "type": "string", "minLength": 1 },
        "replay_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "round_id": { "type": "string", "minLength": 1 },
        "round_no": { "type": "integer", "minimum": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "settlement_result_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
