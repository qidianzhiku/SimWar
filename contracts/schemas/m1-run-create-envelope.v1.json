{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/m1-run-create-envelope.v1.json",
  "title": "M1RunCreateEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "code", "message", "data"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "code": { "const": "OK" },
    "message": { "type": "string", "minLength": 1 },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "round"],
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "tenant_id",
            "course_id",
            "scenario_package_id",
            "parameter_set_id",
            "seed",
            "status"
          ],
          "properties": {
            "run_id": { "type": "string", "minLength": 1 },
            "tenant_id": { "type": "string", "minLength": 1 },
            "course_id": { "type": "string", "minLength": 1 },
            "scenario_package_id": { "type": "string", "minLength": 1 },
            "parameter_set_id": { "type": "string", "minLength": 1 },
            "seed": { "type": "integer" },
            "status": { "enum": ["draft", "active", "completed"] }
          }
        },
        "round": {
          "type": "object",
          "additionalProperties": false,
          "required": ["round_id", "tenant_id", "run_id", "round_no", "status"],
          "properties": {
            "round_id": { "type": "string", "minLength": 1 },
            "tenant_id": { "type": "string", "minLength": 1 },
            "run_id": { "type": "string", "minLength": 1 },
            "round_no": { "type": "integer", "minimum": 1 },
            "status": { "enum": ["draft", "open", "locked", "settled", "published"] },
            "decision_batch_id": { "type": "string", "minLength": 1 },
            "replay_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    }
  }
}
