{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/w027-decision-experience.v1.json",
  "title": "W027 Decision Experience",
  "oneOf": [{ "$ref": "#/$defs/student" }, { "$ref": "#/$defs/teacher" }],
  "$defs": {
    "role": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
    "kind": { "enum": ["value", "assumption", "evidence", "risk", "tradeoff"] },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "roster_id",
        "tenant_id",
        "course_id",
        "run_id",
        "team_id",
        "role_keys",
        "compatibility_map",
        "version",
        "configured_at",
        "configured_by"
      ],
      "properties": {
        "schema_version": { "const": "w027-role-roster.v1" },
        "roster_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "role_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "compatibility_map": { "const": { "risk": "COO", "Quality & Risk": "COO" } },
        "version": { "type": "integer", "minimum": 1 },
        "configured_at": { "type": "string", "format": "date-time" },
        "configured_by": { "type": "string", "minLength": 1 }
      }
    },
    "private_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "judgment_id",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "kind",
        "statement",
        "evidence_refs",
        "status",
        "version",
        "visibility",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "w027-private-judgment.v1" },
        "judgment_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "kind": { "$ref": "#/$defs/kind" },
        "statement": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["draft", "ready"] },
        "version": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "role_private" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "safe_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "position_id",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "summary",
        "assumptions",
        "evidence_refs",
        "risk_flags",
        "tradeoffs",
        "status",
        "version",
        "visibility",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "w027-role-position.v1" },
        "position_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "summary": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "tradeoffs": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["draft", "ready"] },
        "version": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "team_safe" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "user_id",
        "role_key",
        "permissions",
        "source"
      ],
      "properties": {
        "schema_version": { "const": "w027-role-context.v1" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "user_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "permissions": { "type": "object" },
        "source": { "const": "resolved_from_w027_assignment" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "stages",
        "current_stage",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-decision-trace.v2" },
        "tenant_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "stages": { "type": "array", "items": { "type": "object" } },
        "current_stage": { "type": "string" },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "source_position_ids",
        "source_digest",
        "status",
        "divergences",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-team-divergence.v2" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "source_position_ids": { "type": "array", "items": { "type": "string" } },
        "source_digest": { "type": "string" },
        "status": { "enum": ["NONE", "OPEN", "RESOLVED"] },
        "divergences": { "type": "array", "items": { "type": "object" } },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "context",
        "roster",
        "private_judgments",
        "team_safe_positions",
        "trace",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-student-decision-experience.v1" },
        "context": { "$ref": "#/$defs/context" },
        "roster": { "$ref": "#/$defs/roster" },
        "private_judgments": { "type": "array", "items": { "$ref": "#/$defs/private_judgment" } },
        "own_role_position": { "type": "object" },
        "team_safe_positions": { "type": "array", "items": { "$ref": "#/$defs/safe_position" } },
        "divergence": { "$ref": "#/$defs/divergence" },
        "resolution": { "type": "object" },
        "trace": { "$ref": "#/$defs/trace" },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "roster",
        "role_positions",
        "private_judgment_summary",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-teacher-decision-experience.v1" },
        "roster": { "$ref": "#/$defs/roster" },
        "role_positions": { "type": "array", "items": { "$ref": "#/$defs/private_judgment" } },
        "private_judgment_summary": { "type": "array", "items": { "type": "object" } },
        "divergence": { "$ref": "#/$defs/divergence" },
        "resolution": { "type": "object" },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
