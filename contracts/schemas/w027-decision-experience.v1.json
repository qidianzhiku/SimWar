{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/w027-decision-experience.v1.json",
  "title": "W027 Decision Experience",
  "oneOf": [{ "$ref": "#/$defs/student" }, { "$ref": "#/$defs/teacher" }],
  "$defs": {
    "role": { "enum": ["CEO", "CFO", "CMO", "COO", "CHRO"] },
    "kind": { "enum": ["value", "assumption", "evidence", "risk", "tradeoff"] },
    "decision_right_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "role_key",
        "can_read_role_workspace",
        "can_write_private_judgment",
        "can_publish_role_position",
        "can_propose_resolution",
        "can_acknowledge_resolution",
        "can_merge_team_decision",
        "can_confirm_team_decision",
        "private_judgment_kinds",
        "operational_capabilities",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-decision-right-policy.v1" },
        "policy_id": { "type": "string", "minLength": 1 },
        "role_key": { "$ref": "#/$defs/role" },
        "can_read_role_workspace": { "type": "boolean" },
        "can_write_private_judgment": { "type": "boolean" },
        "can_publish_role_position": { "type": "boolean" },
        "can_propose_resolution": { "type": "boolean" },
        "can_acknowledge_resolution": { "type": "boolean" },
        "can_merge_team_decision": { "type": "boolean" },
        "can_confirm_team_decision": { "type": "boolean" },
        "private_judgment_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kind" }
        },
        "operational_capabilities": { "type": "array", "items": { "type": "string" } },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "roster_id",
        "tenant_id",
        "course_id",
        "run_id",
        "team_id",
        "role_keys",
        "compatibility_map",
        "decision_right_policies",
        "version",
        "configured_at",
        "configured_by"
      ],
      "properties": {
        "schema_version": { "const": "w027-role-roster.v1" },
        "roster_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "role_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "compatibility_map": { "const": { "risk": "COO", "Quality & Risk": "COO" } },
        "decision_right_policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/decision_right_policy" }
        },
        "version": { "type": "integer", "minimum": 1 },
        "configured_at": { "type": "string", "format": "date-time" },
        "configured_by": { "type": "string", "minLength": 1 }
      }
    },
    "private_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "judgment_id",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "kind",
        "problem_frame",
        "assumptions",
        "options_considered",
        "trade_offs",
        "prediction",
        "confidence",
        "rationale",
        "statement",
        "evidence_refs",
        "status",
        "version",
        "visibility",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "w027-private-judgment.v1" },
        "judgment_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "kind": { "$ref": "#/$defs/kind" },
        "problem_frame": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "options_considered": { "type": "array", "items": { "type": "string" } },
        "trade_offs": { "type": "array", "items": { "type": "string" } },
        "prediction": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["draft", "ready"] },
        "version": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "role_private" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "safe_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "position_id",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "summary",
        "assumptions",
        "evidence_refs",
        "risk_flags",
        "tradeoffs",
        "status",
        "version",
        "visibility",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "w027-role-position.v1" },
        "position_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "summary": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "tradeoffs": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["draft", "ready"] },
        "version": { "type": "integer", "minimum": 1 },
        "visibility": { "const": "team_safe" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "user_id",
        "role_key",
        "permissions",
        "source"
      ],
      "properties": {
        "schema_version": { "const": "w027-role-context.v1" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "user_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "permissions": { "$ref": "#/$defs/decision_right_policy" },
        "source": { "const": "resolved_from_w027_assignment" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "stages",
        "current_stage",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-decision-trace.v2" },
        "tenant_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "role_key": { "$ref": "#/$defs/role" },
        "stages": { "type": "array", "items": { "type": "object" } },
        "current_stage": { "type": "string" },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "source_position_ids",
        "source_digest",
        "status",
        "divergences",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-team-divergence.v2" },
        "tenant_id": { "type": "string" },
        "course_id": { "type": "string" },
        "run_id": { "type": "string" },
        "round_id": { "type": "string" },
        "team_id": { "type": "string" },
        "source_position_ids": { "type": "array", "items": { "type": "string" } },
        "source_digest": { "type": "string" },
        "status": { "enum": ["NONE", "OPEN", "RESOLVED"] },
        "divergences": { "type": "array", "items": { "type": "object" } },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "resolution_id",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "source_digest",
        "resolution_mode",
        "selected_option",
        "rationale",
        "supporting_evidence_refs",
        "trade_off",
        "risk",
        "affected_divergence_ids",
        "authority_role_key",
        "selected_position_ids",
        "preserved_dissent_role_keys",
        "acknowledged_role_keys",
        "status",
        "proposed_by",
        "proposed_at"
      ],
      "properties": {
        "schema_version": { "const": "w027-resolution.v2" },
        "resolution_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "source_digest": { "type": "string", "minLength": 1 },
        "resolution_mode": {
          "enum": ["OBSERVED_CANDIDATE_SELECTION", "EXPLICIT_TEAM_COMPROMISE"]
        },
        "selected_option": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "supporting_evidence_refs": { "type": "array", "items": { "type": "string" } },
        "trade_off": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "affected_divergence_ids": { "type": "array", "items": { "type": "string" } },
        "authority_role_key": { "$ref": "#/$defs/role" },
        "selected_position_ids": { "type": "array", "items": { "type": "string" } },
        "preserved_dissent_role_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/role" }
        },
        "acknowledged_role_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/role" }
        },
        "status": { "enum": ["PROPOSED", "ACKS_COMPLETE"] },
        "proposed_by": { "type": "string", "minLength": 1 },
        "proposed_at": { "type": "string", "format": "date-time" }
      }
    },
    "resolution_safe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "resolution_id",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "source_digest",
        "resolution_mode",
        "selected_option",
        "rationale",
        "supporting_evidence_refs",
        "trade_off",
        "risk",
        "affected_divergence_ids",
        "authority_role_key",
        "selected_position_ids",
        "preserved_dissent_role_keys",
        "acknowledged_role_keys",
        "status",
        "proposed_at"
      ],
      "properties": {
        "schema_version": { "const": "w027-resolution.v2" },
        "resolution_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "course_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "round_id": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "minLength": 1 },
        "source_digest": { "type": "string", "minLength": 1 },
        "resolution_mode": {
          "enum": ["OBSERVED_CANDIDATE_SELECTION", "EXPLICIT_TEAM_COMPROMISE"]
        },
        "selected_option": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "supporting_evidence_refs": { "type": "array", "items": { "type": "string" } },
        "trade_off": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "affected_divergence_ids": { "type": "array", "items": { "type": "string" } },
        "authority_role_key": { "$ref": "#/$defs/role" },
        "selected_position_ids": { "type": "array", "items": { "type": "string" } },
        "preserved_dissent_role_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/role" }
        },
        "acknowledged_role_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/role" }
        },
        "status": { "enum": ["PROPOSED", "ACKS_COMPLETE"] },
        "proposed_at": { "type": "string", "format": "date-time" }
      }
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "context",
        "roster",
        "private_judgments",
        "team_safe_positions",
        "trace",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-student-decision-experience.v1" },
        "context": { "$ref": "#/$defs/context" },
        "roster": { "$ref": "#/$defs/roster" },
        "private_judgments": { "type": "array", "items": { "$ref": "#/$defs/private_judgment" } },
        "own_role_position": { "$ref": "#/$defs/safe_position" },
        "team_safe_positions": { "type": "array", "items": { "$ref": "#/$defs/safe_position" } },
        "divergence": { "$ref": "#/$defs/divergence" },
        "resolution": { "$ref": "#/$defs/resolution_safe" },
        "trace": { "$ref": "#/$defs/trace" },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "roster",
        "role_positions",
        "private_judgment_summary",
        "known_limits"
      ],
      "properties": {
        "schema_version": { "const": "w027-teacher-decision-experience.v1" },
        "roster": { "$ref": "#/$defs/roster" },
        "role_positions": { "type": "array", "items": { "$ref": "#/$defs/safe_position" } },
        "private_judgment_summary": { "type": "array", "items": { "type": "object" } },
        "divergence": { "$ref": "#/$defs/divergence" },
        "resolution": { "$ref": "#/$defs/resolution" },
        "known_limits": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
