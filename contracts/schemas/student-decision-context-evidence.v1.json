{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/student-decision-context-evidence.v1.json",
  "title": "Student-safe decision context evidence continuity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_version",
    "status",
    "scope",
    "continuity",
    "known_limits"
  ],
  "properties": {
    "schema_version": { "const": "student-decision-context-evidence.v1" },
    "evidence_id": { "$ref": "#/$defs/identity" },
    "evidence_version": { "const": "student-decision-context.v1" },
    "status": { "enum": ["READY", "BLOCKED"] },
    "scope": { "$ref": "#/$defs/context" },
    "source_context": { "$ref": "#/$defs/sourceContext" },
    "continuity": { "$ref": "#/$defs/continuity" },
    "blocker_codes": {
      "type": "array",
      "items": { "const": "SOURCE_EVIDENCE_UNAVAILABLE" },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "known_limits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/safeText" }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$",
      "not": {
        "pattern": "(?:^|[._:-])(?:any|current|default|fallback|latest|next|unresolved)(?:$|[._:-])"
      }
    },
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^<>\\u0000-\\u001F\\u007F]+$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "course_id",
        "role_key",
        "round_id",
        "round_no",
        "run_id",
        "team_id",
        "tenant_id"
      ],
      "properties": {
        "activity_id": { "$ref": "#/$defs/identity" },
        "course_id": { "$ref": "#/$defs/identity" },
        "role_key": { "$ref": "#/$defs/identity" },
        "round_id": { "$ref": "#/$defs/identity" },
        "round_no": { "type": "integer", "minimum": 1 },
        "run_id": { "$ref": "#/$defs/identity" },
        "team_id": { "$ref": "#/$defs/identity" },
        "tenant_id": { "$ref": "#/$defs/identity" }
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_region",
        "epoch_version",
        "qualification_status",
        "consumption_status",
        "exact_binding_required"
      ],
      "properties": {
        "target_region": { "const": "Hangzhou" },
        "epoch_version": { "$ref": "#/$defs/identity" },
        "qualification_status": { "const": "LIMITED" },
        "consumption_status": { "const": "LOOKAHEAD_READY" },
        "exact_binding_required": { "const": true }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "decision", "consequence", "debrief", "regional_transfer"],
      "properties": {
        "context": { "$ref": "#/$defs/stage" },
        "decision": { "$ref": "#/$defs/stage" },
        "consequence": { "$ref": "#/$defs/stage" },
        "debrief": { "$ref": "#/$defs/stage" },
        "regional_transfer": { "$ref": "#/$defs/stage" }
      }
    },
    "stage": { "enum": ["PROVEN", "PENDING_PUBLISH", "BLOCKED"] }
  }
}
