{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/course-blueprint-version.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["activity_plan", "course_blueprint_id", "description", "duration_minutes", "instructor_guidance_reference", "objectives", "ordered_phases", "required_product_capabilities", "scenario_compatibility_constraints", "schema_version", "tenant_id", "title", "version"],
  "properties": {
    "activity_plan": { "type": "array" },
    "course_blueprint_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "duration_minutes": { "type": "integer", "minimum": 1 },
    "instructor_guidance_reference": { "type": "string", "minLength": 1 },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "ordered_phases": { "type": "array", "minItems": 1 },
    "required_product_capabilities": { "type": "array", "items": { "type": "string" } },
    "scenario_compatibility_constraints": { "type": "object", "additionalProperties": { "type": "string" } },
    "schema_version": { "const": "course-blueprint.v1" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 }
  }
}
