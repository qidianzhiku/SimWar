{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/schemas/a5-compatibility.v1.json",
  "title": "A5 Compatibility Fixture Set",
  "description": "Closed, JSON-internal compatibility shapes for immutable references, provenance, evidence, and decision-thread traceability. This schema validates closed object shapes, discriminators, exact-reference structure, and event variants; cross-reference semantics are enforced by pure @simwar/shared-contracts validators and focused tests.",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "exact_ref": { "$ref": "#/$defs/ExactRef" },
    "mode_binding": { "$ref": "#/$defs/ModeBinding" },
    "evidence_artifact": { "$ref": "#/$defs/EvidenceArtifact" },
    "provenance_edge": { "$ref": "#/$defs/ProvenanceEdge" },
    "decision_thread_ref": { "$ref": "#/$defs/DecisionThreadRef" },
    "events": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/DomainEventEnvelope" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ExactIdentity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$",
      "not": {
        "type": "string",
        "pattern": "(?:^|[._:-])(?:[Aa][Nn][Yy]|[Cc][Uu][Rr][Rr][Ee][Nn][Tt]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Ff][Aa][Ll][Ll][Bb][Aa][Cc][Kk]|[Ll][Aa][Tt][Ee][Ss][Tt]|[Nn][Ee][Xx][Tt]|[Uu][Nn][Rr][Ee][Ss][Oo][Ll][Vv][Ee][Dd])(?:$|[._:-])"
      }
    },
    "ExactVersion": {
      "allOf": [
        { "$ref": "#/$defs/ExactIdentity" },
        {
          "not": {
            "type": "string",
            "pattern": "(?:^|[._:-])(?:[Xx]|\\*)(?:$|[._:-])"
          }
        }
      ]
    },
    "ExactRef": {
      "type": "object",
      "required": [
        "content_digest",
        "discriminator",
        "resource_id",
        "resource_type",
        "tenant_id",
        "version"
      ],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "discriminator": { "const": "exact_ref" },
        "resource_id": { "$ref": "#/$defs/ExactIdentity" },
        "resource_type": {
          "enum": [
            "course_blueprint",
            "instructor_artifact",
            "model_artifact",
            "evidence_artifact",
            "decision_thread"
          ]
        },
        "tenant_id": { "$ref": "#/$defs/ExactIdentity" },
        "version": { "$ref": "#/$defs/ExactVersion" }
      },
      "additionalProperties": false
    },
    "ModeBinding": {
      "type": "object",
      "required": ["discriminator", "mode", "subject_ref"],
      "properties": {
        "discriminator": { "const": "mode_binding" },
        "mode": { "enum": ["reference_only", "advisory_only", "evidence_only"] },
        "subject_ref": { "$ref": "#/$defs/ExactRef" }
      },
      "additionalProperties": false
    },
    "EvidenceArtifact": {
      "type": "object",
      "required": ["artifact_kind", "artifact_ref", "captured_at", "discriminator", "mode_binding"],
      "properties": {
        "artifact_kind": { "enum": ["document", "observation", "model_output"] },
        "artifact_ref": {
          "allOf": [
            { "$ref": "#/$defs/ExactRef" },
            {
              "type": "object",
              "properties": { "resource_type": { "const": "evidence_artifact" } }
            }
          ]
        },
        "captured_at": { "type": "string", "format": "a5-utc-timestamp" },
        "discriminator": { "const": "evidence_artifact" },
        "mode_binding": {
          "type": "object",
          "required": ["discriminator", "mode", "subject_ref"],
          "properties": {
            "discriminator": { "const": "mode_binding" },
            "mode": { "enum": ["reference_only", "advisory_only", "evidence_only"] },
            "subject_ref": { "$ref": "#/$defs/ExactRef" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ProvenanceEdge": {
      "type": "object",
      "required": ["discriminator", "relation", "source_ref", "target_ref"],
      "properties": {
        "discriminator": { "const": "provenance_edge" },
        "relation": { "enum": ["derived_from", "supported_by", "cites"] },
        "source_ref": { "$ref": "#/$defs/ExactRef" },
        "target_ref": { "$ref": "#/$defs/ExactRef" }
      },
      "additionalProperties": false
    },
    "DecisionThreadRef": {
      "type": "object",
      "required": ["aliases", "discriminator", "thread_ref"],
      "properties": {
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["alias", "discriminator", "target_ref"],
            "properties": {
              "alias": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
              "discriminator": { "const": "decision_thread_alias" },
              "target_ref": { "$ref": "#/$defs/ExactRef" }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "discriminator": { "const": "decision_thread_ref" },
        "thread_ref": {
          "allOf": [
            { "$ref": "#/$defs/ExactRef" },
            {
              "type": "object",
              "properties": { "resource_type": { "const": "decision_thread" } }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "EventModeBinding": {
      "type": "object",
      "required": ["discriminator", "mode", "subject_ref"],
      "properties": {
        "discriminator": { "const": "mode_binding" },
        "mode": { "enum": ["reference_only", "advisory_only", "evidence_only"] },
        "subject_ref": { "$ref": "#/$defs/ExactRef" }
      },
      "additionalProperties": false
    },
    "EventProvenanceEdge": {
      "type": "object",
      "required": ["discriminator", "relation", "source_ref", "target_ref"],
      "properties": {
        "discriminator": { "const": "provenance_edge" },
        "relation": { "enum": ["derived_from", "supported_by", "cites"] },
        "source_ref": { "$ref": "#/$defs/ExactRef" },
        "target_ref": { "$ref": "#/$defs/ExactRef" }
      },
      "additionalProperties": false
    },
    "ReferenceRecordedEventEnvelope": {
      "type": "object",
      "required": [
        "discriminator",
        "event_id",
        "event_type",
        "mode_binding",
        "occurred_at",
        "provenance_edge",
        "subject_ref"
      ],
      "properties": {
        "discriminator": { "const": "domain_event_envelope" },
        "event_id": { "$ref": "#/$defs/ExactIdentity" },
        "event_type": { "const": "reference_recorded" },
        "mode_binding": { "$ref": "#/$defs/EventModeBinding" },
        "occurred_at": { "type": "string", "format": "a5-utc-timestamp" },
        "provenance_edge": { "$ref": "#/$defs/EventProvenanceEdge" },
        "subject_ref": { "$ref": "#/$defs/ExactRef" }
      },
      "additionalProperties": false
    },
    "EvidenceLinkedEventEnvelope": {
      "type": "object",
      "required": [
        "discriminator",
        "event_id",
        "event_type",
        "evidence_artifact",
        "mode_binding",
        "occurred_at",
        "provenance_edge",
        "subject_ref"
      ],
      "properties": {
        "discriminator": { "const": "domain_event_envelope" },
        "event_id": { "$ref": "#/$defs/ExactIdentity" },
        "event_type": { "const": "evidence_linked" },
        "evidence_artifact": { "$ref": "#/$defs/EvidenceArtifact" },
        "mode_binding": { "$ref": "#/$defs/EventModeBinding" },
        "occurred_at": { "type": "string", "format": "a5-utc-timestamp" },
        "provenance_edge": { "$ref": "#/$defs/EventProvenanceEdge" },
        "subject_ref": { "$ref": "#/$defs/ExactRef" }
      },
      "additionalProperties": false
    },
    "DecisionThreadLinkedEventEnvelope": {
      "type": "object",
      "required": [
        "decision_thread_ref",
        "discriminator",
        "event_id",
        "event_type",
        "mode_binding",
        "occurred_at",
        "provenance_edge",
        "subject_ref"
      ],
      "properties": {
        "decision_thread_ref": { "$ref": "#/$defs/DecisionThreadRef" },
        "discriminator": { "const": "domain_event_envelope" },
        "event_id": { "$ref": "#/$defs/ExactIdentity" },
        "event_type": { "const": "decision_thread_linked" },
        "mode_binding": { "$ref": "#/$defs/EventModeBinding" },
        "occurred_at": { "type": "string", "format": "a5-utc-timestamp" },
        "provenance_edge": { "$ref": "#/$defs/EventProvenanceEdge" },
        "subject_ref": { "$ref": "#/$defs/ExactRef" }
      },
      "additionalProperties": false
    },
    "DomainEventEnvelope": {
      "oneOf": [
        { "$ref": "#/$defs/ReferenceRecordedEventEnvelope" },
        { "$ref": "#/$defs/EvidenceLinkedEventEnvelope" },
        { "$ref": "#/$defs/DecisionThreadLinkedEventEnvelope" }
      ]
    }
  }
}
