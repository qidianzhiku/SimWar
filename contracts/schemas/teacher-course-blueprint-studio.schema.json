{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/teacher-course-blueprint-studio.schema.json",
  "title": "TeacherCourseBlueprintStudioEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "code", "message", "data"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "code": { "const": "OK" },
    "message": { "type": "string", "minLength": 1 },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/preview" },
        { "$ref": "#/$defs/draft" },
        { "$ref": "#/$defs/submission" }
      ]
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "course_blueprint_id", "tenant_id", "version"],
      "properties": {
        "content_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "course_blueprint_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_type",
        "duration_minutes",
        "order",
        "phase_id",
        "student_instruction",
        "teacher_guidance",
        "title"
      ],
      "properties": {
        "activity_type": { "type": "string", "minLength": 1 },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "phase_id": { "type": "string", "minLength": 1 },
        "student_instruction": { "type": "string", "minLength": 1 },
        "teacher_guidance": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "editable_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_plan",
        "description",
        "duration_minutes",
        "instructor_guidance_reference",
        "objectives",
        "ordered_phases",
        "required_product_capabilities",
        "scenario_compatibility_constraints",
        "schema_version",
        "title",
        "version"
      ],
      "properties": {
        "activity_plan": { "type": "array" },
        "description": { "type": "string", "minLength": 1 },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "instructor_guidance_reference": { "type": "string", "minLength": 1 },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "description": "Draft objectives may be empty after normalization; explicit submission performs lifecycle validation.",
          "items": { "type": "string" }
        },
        "ordered_phases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/phase" }
        },
        "required_product_capabilities": {
          "type": "array",
          "description": "Draft capability entries may be empty after normalization; explicit submission performs lifecycle validation.",
          "items": { "type": "string" }
        },
        "scenario_compatibility_constraints": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "schema_version": { "const": "course-blueprint.v1" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "course_blueprint_reference", "editable_content", "status"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "course_blueprint_reference": { "$ref": "#/$defs/reference" },
        "editable_content": { "$ref": "#/$defs/editable_content" },
        "status": { "enum": ["APPROVED", "DRAFT", "VALIDATED"] }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "course_blueprint_reference",
        "source_course_blueprint_reference",
        "status",
        "title",
        "version"
      ],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "course_blueprint_reference": { "$ref": "#/$defs/reference" },
        "source_course_blueprint_reference": { "$ref": "#/$defs/reference" },
        "status": { "const": "DRAFT" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_blueprint_reference", "status"],
      "properties": {
        "course_blueprint_reference": { "$ref": "#/$defs/reference" },
        "status": { "const": "VALIDATED" }
      }
    }
  }
}
