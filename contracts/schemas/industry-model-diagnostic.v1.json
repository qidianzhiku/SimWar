{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/schemas/industry-model-diagnostic.v1.json",
  "title": "SimWar Industry Model Diagnostic Readiness",
  "oneOf": [{ "$ref": "#/$defs/teacherOrAdmin" }, { "$ref": "#/$defs/student" }],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelVersionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_version_id", "version", "content_digest"],
      "properties": {
        "model_version_id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "modelArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_digest", "format", "source_ref"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmptyString" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "format": { "$ref": "#/$defs/nonEmptyString" },
        "source_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "course_id",
        "run_id",
        "team_id",
        "round_id",
        "scenario_package_id",
        "parameter_set_id"
      ],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/nonEmptyString" },
        "course_id": { "$ref": "#/$defs/nonEmptyString" },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "team_id": { "$ref": "#/$defs/nonEmptyString" },
        "round_id": { "$ref": "#/$defs/nonEmptyString" },
        "scenario_package_id": { "$ref": "#/$defs/nonEmptyString" },
        "parameter_set_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "status": { "enum": ["READY", "READY_WITH_LIMITS", "BLOCKED", "REBASE_REQUIRED"] },
    "classification": {
      "enum": ["WANT_EVIDENCE", "CAN_EVIDENCE", "REALIZED_REFERENCE", "NOT_PROVEN"]
    },
    "qualifiedProducerAdmissionStatus": {
      "enum": ["QUALIFICATION_COMPATIBLE", "QUALIFICATION_NOT_PROVEN", "REBASE_REQUIRED"]
    },
    "qualifiedProducerAdmission": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["producer_id", "status", "admission_digest", "known_limits"],
        "properties": {
          "producer_id": { "$ref": "#/$defs/nonEmptyString" },
          "status": { "$ref": "#/$defs/qualifiedProducerAdmissionStatus" },
          "admission_digest": { "$ref": "#/$defs/digest" },
          "known_limits": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
        }
      }
    },
    "provability": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_id",
          "diagnostic_family",
          "classification",
          "evidence_identity",
          "authority_owner",
          "source",
          "freshness"
        ],
        "properties": {
          "producer_id": { "$ref": "#/$defs/nonEmptyString" },
          "diagnostic_family": { "$ref": "#/$defs/nonEmptyString" },
          "classification": { "$ref": "#/$defs/classification" },
          "evidence_identity": { "$ref": "#/$defs/nonEmptyString" },
          "authority_owner": { "$ref": "#/$defs/nonEmptyString" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "symbol"],
            "properties": {
              "path": { "$ref": "#/$defs/nonEmptyString" },
              "symbol": { "$ref": "#/$defs/nonEmptyString" }
            }
          },
          "freshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
          "producer_model_version_reference": { "$ref": "#/$defs/modelVersionReference" },
          "producer_model_artifact_reference": { "$ref": "#/$defs/modelArtifactReference" },
          "known_limits": {
            "type": "array",
            "items": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "studentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "readiness_class", "evidence_classes", "known_limits"],
      "properties": {
        "visibility": { "const": "ROLE_SAFE_STUDENT" },
        "readiness_class": { "$ref": "#/$defs/status" },
        "evidence_classes": { "type": "array", "items": { "$ref": "#/$defs/classification" } },
        "qualified_producer_admission_statuses": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualifiedProducerAdmissionStatus" }
        },
        "known_limits": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "operation_id",
        "role",
        "readiness_status",
        "rebase_required",
        "exact_context",
        "known_limits",
        "provider",
        "official_truth_write",
        "readiness_digest"
      ],
      "properties": {
        "schema_version": { "const": "industry-model-diagnostic-readiness.v1" },
        "operation_id": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["teacher", "admin", "student"] },
        "readiness_status": { "$ref": "#/$defs/status" },
        "rebase_required": { "type": "boolean" },
        "exact_context": { "$ref": "#/$defs/context" },
        "known_limits": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "provider": { "const": "OFF" },
        "official_truth_write": { "const": false },
        "readiness_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "teacherOrAdmin": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": [
            "model_version_reference",
            "model_artifact_reference",
            "qualification",
            "adoption",
        "diagnostic_evidence_digest",
        "interpretation_policy_digest",
        "provability",
        "qualified_producer_admission"
          ],
          "properties": {
            "operation_id": {
              "enum": [
                "INDUSTRY_MODEL_DIAGNOSTIC_TEACHER_GET_V1",
                "INDUSTRY_MODEL_DIAGNOSTIC_ADMIN_GET_V1"
              ]
            },
            "role": { "enum": ["teacher", "admin"] },
            "model_version_reference": { "type": "object", "additionalProperties": true },
            "model_artifact_reference": { "type": "object", "additionalProperties": true },
            "qualification": { "type": "object", "additionalProperties": true },
            "adoption": {
              "oneOf": [{ "type": "object", "additionalProperties": true }, { "type": "null" }]
            },
            "diagnostic_evidence_digest": { "$ref": "#/$defs/digest" },
            "interpretation_policy_digest": { "$ref": "#/$defs/digest" },
            "provability": { "$ref": "#/$defs/provability" },
            "qualified_producer_admission": { "$ref": "#/$defs/qualifiedProducerAdmission" }
          }
        }
      ]
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "role",
        "readiness_status",
        "rebase_required",
        "exact_context",
        "known_limits",
        "provider",
        "official_truth_write",
        "readiness_digest",
        "student_summary"
      ],
      "properties": {
        "schema_version": { "const": "industry-model-diagnostic-readiness.v1" },
        "operation_id": { "const": "INDUSTRY_MODEL_DIAGNOSTIC_STUDENT_GET_V1" },
        "role": { "const": "student" },
        "readiness_status": { "$ref": "#/$defs/status" },
        "rebase_required": { "type": "boolean" },
        "exact_context": { "$ref": "#/$defs/context" },
        "known_limits": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "provider": { "const": "OFF" },
        "official_truth_write": { "const": false },
        "readiness_digest": { "$ref": "#/$defs/digest" },
        "student_summary": { "$ref": "#/$defs/studentSummary" }
      }
    }
  }
}
