{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "data", "request_id"],
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string" },
    "request_id": { "type": "string" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_workspace",
        "round_control",
        "teacher_dashboard",
        "teacher_replay_summary",
        "team_monitor"
      ],
      "properties": {
        "course_workspace": { "type": "object" },
        "round_control": { "type": "object" },
        "teacher_dashboard": { "type": "object" },
        "teacher_replay_summary": { "type": "object" },
        "team_monitor": { "type": "object" }
      }
    }
  }
}
