{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/schemas/w020-governed-ai-advisory.v1.json",
  "title": "W020 Governed AI Advisory BFF Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discriminator",
    "status",
    "request_id",
    "request_digest",
    "context",
    "projection",
    "formal_truth_write",
    "known_limits"
  ],
  "properties": {
    "discriminator": { "const": "w020_advisory_receipt" },
    "status": { "enum": ["generated", "reused"] },
    "request_id": { "$ref": "#/$defs/identifier" },
    "request_digest": { "$ref": "#/$defs/digest" },
    "context": { "$ref": "#/$defs/context" },
    "projection": { "$ref": "#/$defs/projection" },
    "formal_truth_write": { "const": false },
    "known_limits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonBlank" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^(?![Ll][Aa][Tt][Ee][Ss][Tt]$)(?![Dd][Ee][Ff][Aa][Uu][Ll][Tt]$)(?![Ff][Aa][Ll][Ll][Bb][Aa][Cc][Kk]$)(?![Uu][Nn][Rr][Ee][Ss][Oo][Ll][Vv][Ee][Dd]$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonBlank": { "type": "string", "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$" },
    "roleKey": { "enum": ["CEO", "CFO", "CMO", "COO"] },
    "teacherSafeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_schema_version",
        "activity_id",
        "role_key",
        "course_report_available",
        "confirmation_status",
        "outcome_status",
        "eligible_event_count",
        "evidence_count",
        "missing",
        "student_safe_preview",
        "runtime_authority",
        "known_limits"
      ],
      "properties": {
        "source_schema_version": { "const": "teaching-closure.v1" },
        "activity_id": { "$ref": "#/$defs/identifier" },
        "role_key": { "$ref": "#/$defs/roleKey" },
        "course_report_available": { "const": true },
        "confirmation_status": { "const": "CONFIRMED" },
        "outcome_status": { "const": "CONFIRMED" },
        "eligible_event_count": { "type": "integer", "minimum": 1 },
        "evidence_count": { "type": "integer", "minimum": 1 },
        "missing": { "type": "array", "maxItems": 0 },
        "student_safe_preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criterion_count", "evidence_count", "next_focus", "status", "visibility"],
          "properties": {
            "criterion_count": { "type": "integer", "minimum": 1 },
            "evidence_count": { "type": "integer", "minimum": 1 },
            "next_focus": { "$ref": "#/$defs/nonBlank" },
            "status": { "const": "CONFIRMED" },
            "visibility": { "const": "student_safe" }
          }
        },
        "runtime_authority": { "const": "JSON_INTERNAL_ONLY" },
        "known_limits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discriminator",
        "actor_role",
        "actor_id_hash",
        "tenant_id",
        "course_id",
        "run_id",
        "round_id",
        "team_id",
        "role_key",
        "advisory_scopes",
        "source_event_ids",
        "source_event_types",
        "context_digest",
        "transformation_version"
      ],
      "properties": {
        "discriminator": { "const": "w020_role_safe_context" },
        "actor_role": { "enum": ["student", "teacher", "admin"] },
        "actor_id_hash": { "$ref": "#/$defs/digest" },
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "course_id": { "$ref": "#/$defs/identifier" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "round_id": { "$ref": "#/$defs/identifier" },
        "team_id": { "$ref": "#/$defs/identifier" },
        "role_key": { "$ref": "#/$defs/roleKey" },
        "activity_id": { "$ref": "#/$defs/identifier" },
        "teacher_safe_source": { "$ref": "#/$defs/teacherSafeSource" },
        "advisory_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "source_event_ids": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "source_event_types": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "context_digest": { "$ref": "#/$defs/digest" },
        "transformation_version": { "const": "w020-role-safe-context-v1" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "actor_role": { "const": "student" } },
            "required": ["actor_role"]
          },
          "then": {
            "properties": {
              "activity_id": false,
              "teacher_safe_source": false
            }
          }
        },
        {
          "if": {
            "properties": { "actor_role": { "enum": ["teacher", "admin"] } },
            "required": ["actor_role"]
          },
          "then": {
            "properties": {
              "activity_id": {},
              "teacher_safe_source": {}
            },
            "required": ["activity_id", "teacher_safe_source"]
          }
        }
      ]
    },
    "teacherDebrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "role_key",
        "discussion_prompts",
        "explanations",
        "tradeoffs",
        "next_focus"
      ],
      "properties": {
        "activity_id": { "$ref": "#/$defs/identifier" },
        "role_key": { "$ref": "#/$defs/roleKey" },
        "discussion_prompts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "explanations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "next_focus": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "surface",
        "title",
        "recommendations",
        "evidence_refs",
        "known_limits"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "surface": { "enum": ["student_role", "teacher_debrief"] },
        "title": { "$ref": "#/$defs/nonBlank" },
        "recommendations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "known_limits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "teacher_debrief": { "$ref": "#/$defs/teacherDebrief" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "surface": { "const": "student_role" } },
            "required": ["surface"]
          },
          "then": { "properties": { "teacher_debrief": false } }
        },
        {
          "if": {
            "properties": { "surface": { "const": "teacher_debrief" } },
            "required": ["surface"]
          },
          "then": {
            "properties": { "teacher_debrief": {} },
            "required": ["teacher_debrief"]
          }
        }
      ]
    }
  }
}
