{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/contracts/sh-second-city-transfer-requalification.v1.json",
  "title": "Shanghai second-city public-source transfer requalification candidate",
  "type": "object",
  "required": [
    "schema_version",
    "mission_id",
    "state_a",
    "state_b",
    "state_transition",
    "evidence_epoch_ref",
    "second_city",
    "transfer",
    "transfer_summary",
    "compatibility",
    "qualification",
    "pr475_absorption",
    "role_visibility",
    "authority",
    "known_limits",
    "pack_digest"
  ],
  "properties": {
    "schema_version": { "const": "sh-second-city-transfer-requalification.v1" },
    "mission_id": { "const": "SIMWAR-SH-M27-SECOND-CITY-PUBLIC-SOURCE-TRANSFER-REQUALIFICATION" },
    "state_a": {
      "type": "object",
      "required": ["name", "limitation"],
      "properties": {
        "name": { "const": "SINGLE_CITY_TRANSFER_WITHOUT_SECOND_CITY_REQUALIFICATION" },
        "limitation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "state_b": { "const": "SECOND_CITY_PUBLIC_SOURCE_TRANSFER_REQUALIFICATION_READY" },
    "state_transition": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "const": "STATE_A" }, "to": { "const": "STATE_B" } },
      "additionalProperties": false
    },
    "evidence_epoch_ref": {
      "type": "object",
      "required": ["epoch_id", "epoch_digest", "source_epoch_base_sha"],
      "properties": {
        "epoch_id": { "type": "string", "minLength": 1 },
        "epoch_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_epoch_base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "second_city": {
      "type": "object",
      "required": ["city", "source_receipt_ids", "source_asset_ids", "public_source_coverage", "source_reality_class", "synthetic_only", "rights_status", "expiry"],
      "properties": {
        "city": { "const": "Hangzhou" },
        "source_receipt_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_asset_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "public_source_coverage": { "const": true },
        "source_reality_class": { "const": "PUBLIC_SOURCE_BOUND" },
        "synthetic_only": { "const": false },
        "rights_status": { "const": "PUBLIC_REFERENCE_ONLY" },
        "expiry": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "transfer": { "$ref": "#/$defs/regionalTransferEnvelope" },
    "transfer_summary": {
      "type": "object",
      "required": ["schema_version", "transfer_id", "baseline_region", "target_region", "source_feature_ids", "target_feature_ids", "method", "output", "rights_status", "valid_from", "valid_to", "approval_status"],
      "properties": {
        "schema_version": { "const": "regional-transfer.v1" },
        "transfer_id": { "type": "string", "minLength": 1 },
        "baseline_region": { "const": "Shanghai" },
        "target_region": { "const": "Hangzhou" },
        "source_feature_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "target_feature_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "method": { "type": "string", "minLength": 1 },
        "output": { "const": "REQUALIFICATION_REQUIRED" },
        "rights_status": { "const": "PUBLIC_REFERENCE_ONLY" },
        "valid_from": { "type": "string", "format": "date" },
        "valid_to": { "type": "string", "format": "date" },
        "approval_status": { "const": "CANDIDATE_ONLY" }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["same_schema_shape", "shared_contract", "exact_binding_required", "differences", "compatibility_digest"],
      "properties": {
        "same_schema_shape": { "const": true },
        "shared_contract": { "const": "regional-transfer.v1" },
        "exact_binding_required": { "const": true },
        "differences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/difference" } },
        "compatibility_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": ["status", "source_status", "calibration_evidence", "calibration_eligible", "formal_binding_eligible", "reason", "required_rechecks"],
      "properties": {
        "status": { "enum": ["READY", "LIMITED", "NOT_ELIGIBLE", "NOT_COMPUTABLE"] },
        "source_status": { "const": "PUBLIC_SOURCE_BOUND" },
        "calibration_evidence": { "const": "NOT_PROVEN" },
        "calibration_eligible": { "const": false },
        "formal_binding_eligible": { "const": false },
        "reason": { "type": "string", "minLength": 1 },
        "required_rechecks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "pr475_absorption": {
      "type": "object",
      "required": ["pr_number", "current_state", "base_sha", "head_sha", "unresolved_review_threads", "absorbed_concepts", "no_conflicting_writer", "no_auto_cherry_pick", "integration_stage"],
      "properties": {
        "pr_number": { "const": 475 },
        "current_state": { "const": "OPEN" },
        "base_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "unresolved_review_threads": { "type": "integer", "minimum": 0 },
        "absorbed_concepts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "no_conflicting_writer": { "const": true },
        "no_auto_cherry_pick": { "const": true },
        "integration_stage": { "const": "LOOKAHEAD_READY" }
      },
      "additionalProperties": false
    },
    "role_visibility": {
      "type": "object",
      "required": ["teacher", "student", "admin"],
      "properties": {
        "teacher": { "$ref": "#/$defs/teacherVisibility" },
        "student": { "$ref": "#/$defs/studentVisibility" },
        "admin": { "$ref": "#/$defs/adminVisibility" }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["candidate_writer", "official_truth_write", "settlement_write", "parameter_set_formal_write", "provider", "second_truth_writer", "runtime_authority"],
      "properties": {
        "candidate_writer": { "const": "SH_NEXT_SUPPORT_CANDIDATE_COMPILER" },
        "official_truth_write": { "const": false },
        "settlement_write": { "const": false },
        "parameter_set_formal_write": { "const": false },
        "provider": { "const": "OFF" },
        "second_truth_writer": { "const": false },
        "runtime_authority": { "const": "JSON_INTERNAL_ONLY" }
      },
      "additionalProperties": false
    },
    "known_limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "pack_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "regionalTransferEnvelope": {
      "type": "object",
      "required": ["schema_version", "candidate_ref", "consumer_scope", "scope", "baseline", "target", "formal_references", "provenance", "qualification", "diff", "impact", "activation", "authority", "rollback", "lifecycle", "known_limits"],
      "properties": {
        "schema_version": { "const": "regional-transfer.v1" },
        "candidate_ref": {
          "type": "object",
          "required": ["candidate_id", "content_digest", "tenant_id", "version"],
          "properties": {
            "candidate_id": { "type": "string", "minLength": 1 },
            "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "tenant_id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
          },
          "additionalProperties": false
        },
        "consumer_scope": {
          "type": "object",
          "required": ["minimum_team_count", "run_id", "status", "team_ids"],
          "properties": {
            "minimum_team_count": { "const": 2 },
            "run_id": { "type": "string", "minLength": 1 },
            "status": { "const": "SHARED_GOVERNED_SCENARIO" },
            "team_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "required": ["course_id", "round_no", "run_id", "tenant_id"],
          "properties": {
            "course_id": { "type": "string", "minLength": 1 },
            "round_no": { "type": "integer", "minimum": 1 },
            "run_id": { "type": "string", "minLength": 1 },
            "tenant_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "baseline": { "$ref": "#/$defs/envelopeRegionPackage" },
        "target": { "$ref": "#/$defs/envelopeRegionPackage" },
        "formal_references": {
          "type": "object",
          "required": ["course_blueprint_reference", "parameter_set_reference", "scenario_package_reference"],
          "properties": {
            "course_blueprint_reference": { "$ref": "#/$defs/courseBlueprintReference" },
            "parameter_set_reference": { "$ref": "#/$defs/parameterSetReference" },
            "scenario_package_reference": { "$ref": "#/$defs/scenarioPackageReference" }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["current_source_readback", "support_packs"],
          "properties": {
            "current_source_readback": { "const": "EXACT_SOURCE_READBACK_REQUIRED" },
            "support_packs": {
              "type": "object",
              "required": ["m4_pack_digest", "m4_source_revision", "m5_pack_digest", "m5_source_revision", "m6_pack_digest", "m6_source_revision"],
              "properties": {
                "m4_pack_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "m4_source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                "m5_pack_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "m5_source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
                "m6_pack_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "m6_source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "qualification": {
          "type": "object",
          "required": ["calibration_eligible", "rights_status", "status", "source_status"],
          "properties": {
            "calibration_eligible": { "const": false },
            "rights_status": { "const": "PUBLIC_SAFE" },
            "status": { "const": "READY_WITH_LIMITS" },
            "source_status": { "const": "REFERENCE_ONLY_WITH_SYNTHETIC_FALLBACK" }
          },
          "additionalProperties": false
        },
        "diff": {
          "type": "object",
          "required": ["changes", "status"],
          "properties": {
            "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/difference" } },
            "status": { "const": "DIFF_RECORDED" }
          },
          "additionalProperties": false
        },
        "impact": {
          "type": "object",
          "required": ["affected_consumers", "requalification_required", "rollback_candidate"],
          "properties": {
            "affected_consumers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "requalification_required": { "const": true },
            "rollback_candidate": { "const": true }
          },
          "additionalProperties": false
        },
        "activation": {
          "type": "object",
          "required": ["published", "status"],
          "properties": { "published": { "const": false }, "status": { "const": "NOT_ACTIVATED" } },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": ["formal_writer_mutations", "official_truth_write", "provider", "runtime_authority", "settlement_write"],
          "properties": {
            "formal_writer_mutations": { "const": 0 },
            "official_truth_write": { "const": false },
            "provider": { "const": "OFF" },
            "runtime_authority": { "const": "JSON_INTERNAL_ONLY" },
            "settlement_write": { "const": false }
          },
          "additionalProperties": false
        },
        "rollback": {
          "type": "object",
          "required": ["candidate_version", "dry_run", "executed", "resolution", "rollback_version", "version_guard"],
          "properties": {
            "candidate_version": { "type": "string", "minLength": 1 },
            "dry_run": { "const": true },
            "executed": { "const": false },
            "resolution": { "const": "SAFE_DRY_RUN_CANDIDATE" },
            "rollback_version": { "type": "string", "minLength": 1 },
            "version_guard": { "const": "EXACT_VERSION_REQUIRED" }
          },
          "additionalProperties": false
        },
        "lifecycle": { "const": "PREVIEWED" },
        "known_limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "envelopeRegionPackage": {
      "type": "object",
      "required": ["package_reference", "region"],
      "properties": {
        "package_reference": { "$ref": "#/$defs/packageReference" },
        "region": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "packageReference": {
      "type": "object",
      "required": ["digest", "package_id", "version"],
      "properties": {
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "package_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      },
      "additionalProperties": false
    },
    "courseBlueprintReference": {
      "type": "object",
      "required": ["content_digest", "course_blueprint_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "course_blueprint_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      },
      "additionalProperties": false
    },
    "parameterSetReference": {
      "type": "object",
      "required": ["content_digest", "parameter_set_id", "version"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parameter_set_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      },
      "additionalProperties": false
    },
    "scenarioPackageReference": {
      "type": "object",
      "required": ["content_digest", "scenario_package_id", "tenant_id", "version"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scenario_package_id": { "type": "string", "minLength": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^(?!latest$|default$|current$).+" }
      },
      "additionalProperties": false
    },
    "difference": {
      "type": "object",
      "required": ["field", "from", "to"],
      "properties": {
        "field": { "enum": ["region", "package", "qualification"] },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "teacherVisibility": {
      "type": "object",
      "required": ["visibility", "fields"],
      "properties": { "visibility": { "const": "TEACHER_ONLY" }, "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
      "additionalProperties": false
    },
    "studentVisibility": {
      "type": "object",
      "required": ["visibility", "fields", "forbidden_fields"],
      "properties": { "visibility": { "const": "STUDENT_SAFE" }, "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "forbidden_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
      "additionalProperties": false
    },
    "adminVisibility": {
      "type": "object",
      "required": ["visibility", "fields"],
      "properties": { "visibility": { "const": "INTERNAL_RESEARCH_ONLY" }, "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
