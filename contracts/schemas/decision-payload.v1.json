{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simwar.local/schemas/decision-payload.v1.json",
  "title": "DecisionPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pricing",
    "marketing_budget",
    "service_quality_budget",
    "capacity_plan",
    "cash_buffer_target",
    "strategy_statement"
  ],
  "properties": {
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_price"],
      "properties": {
        "base_price": {
          "type": "number",
          "minimum": 6000,
          "maximum": 30000
        }
      }
    },
    "marketing_budget": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "service_quality_budget": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "capacity_plan": {
      "type": "string",
      "enum": ["contract", "hold", "expand"]
    },
    "cash_buffer_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.6
    },
    "strategy_statement": {
      "type": "string",
      "minLength": 8,
      "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$",
      "description": "At least 8 characters after trimming leading and trailing whitespace, matching validateDecisionPayload."
    },
    "w4_strategic_action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "payload"],
          "properties": {
            "kind": { "const": "new_project" },
            "version": { "type": "integer", "minimum": 1 },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_name",
                "cost",
                "cycle_rounds",
                "area",
                "beds",
                "bed_mix",
                "ramp",
                "lead_time_rounds"
              ],
              "properties": {
                "project_name": { "type": "string", "minLength": 1 },
                "cost": { "type": "number", "minimum": 0 },
                "cycle_rounds": { "type": "integer", "minimum": 1 },
                "area": { "type": "number", "exclusiveMinimum": 0 },
                "beds": { "type": "number", "exclusiveMinimum": 0 },
                "bed_mix": {
                  "type": "object",
                  "additionalProperties": { "type": "number", "minimum": 0 }
                },
                "ramp": { "type": "number", "minimum": 0, "maximum": 1 },
                "lead_time_rounds": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "payload"],
          "properties": {
            "kind": { "const": "product_line_adjustment" },
            "version": { "type": "integer", "minimum": 1 },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rationale",
                "lead_time_rounds",
                "reversible",
                "dependencies",
                "kpi_hypothesis",
                "product_line_id",
                "operation",
                "target_value"
              ],
              "properties": {
                "rationale": { "type": "string", "minLength": 1 },
                "lead_time_rounds": { "type": "integer", "minimum": 0 },
                "reversible": { "type": "boolean" },
                "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "kpi_hypothesis": { "type": "string", "minLength": 1 },
                "product_line_id": { "type": "string", "minLength": 1 },
                "operation": { "enum": ["add", "update", "remove"] },
                "target_value": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "payload"],
          "properties": {
            "kind": { "const": "positioning_adjustment" },
            "version": { "type": "integer", "minimum": 1 },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rationale",
                "lead_time_rounds",
                "reversible",
                "dependencies",
                "kpi_hypothesis",
                "positioning"
              ],
              "properties": {
                "rationale": { "type": "string", "minLength": 1 },
                "lead_time_rounds": { "type": "integer", "minimum": 0 },
                "reversible": { "type": "boolean" },
                "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "kpi_hypothesis": { "type": "string", "minLength": 1 },
                "positioning": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "payload"],
          "properties": {
            "kind": { "const": "organization_adjustment" },
            "version": { "type": "integer", "minimum": 1 },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rationale",
                "lead_time_rounds",
                "reversible",
                "dependencies",
                "kpi_hypothesis",
                "unit_name",
                "headcount_delta"
              ],
              "properties": {
                "rationale": { "type": "string", "minLength": 1 },
                "lead_time_rounds": { "type": "integer", "minimum": 0 },
                "reversible": { "type": "boolean" },
                "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "kpi_hypothesis": { "type": "string", "minLength": 1 },
                "unit_name": { "type": "string", "minLength": 1 },
                "headcount_delta": { "type": "integer", "not": { "const": 0 } }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "payload"],
          "properties": {
            "kind": { "const": "capital_action" },
            "version": { "type": "integer", "minimum": 1 },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rationale",
                "lead_time_rounds",
                "reversible",
                "dependencies",
                "kpi_hypothesis",
                "capital_action_kind",
                "principal",
                "term_rounds",
                "rate_or_cost_bps",
                "cost_source",
                "covenant_min_cash",
                "fees",
                "obligation"
              ],
              "properties": {
                "rationale": { "type": "string", "minLength": 1 },
                "lead_time_rounds": { "type": "integer", "minimum": 0 },
                "reversible": { "type": "boolean" },
                "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "kpi_hypothesis": { "type": "string", "minLength": 1 },
                "capital_action_kind": {
                  "enum": [
                    "debt",
                    "project_finance",
                    "working_capital",
                    "asset_backed_securitization",
                    "initial_public_offering"
                  ]
                },
                "principal": { "type": "number", "exclusiveMinimum": 0 },
                "term_rounds": { "type": "integer", "minimum": 1 },
                "rate_or_cost_bps": { "type": "number", "minimum": 0 },
                "cost_source": { "type": "string", "minLength": 1 },
                "covenant_min_cash": { "type": "number", "minimum": 0 },
                "fees": { "type": "number", "minimum": 0 },
                "obligation": {
                  "enum": [
                    "term_debt",
                    "project_finance",
                    "working_capital_revolver",
                    "securitized_receivable",
                    "equity"
                  ]
                },
                "project_entry_id": { "type": "string", "minLength": 1 },
                "initiative_id": { "type": "string", "minLength": 1 },
                "policy_seam_id": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    }
  }
}
